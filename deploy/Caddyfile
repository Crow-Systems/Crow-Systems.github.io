{
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}
