# Crow Systems - Environment Configuration
# Copy this file to .env.local and fill in your values

# Site URL (used for Astro.site and canonical URLs)
SITE_URL=http://localhost:3000

# API Base URL
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# API Endpoints
PUBLIC_CONTACT_ENDPOINT=/contact
PUBLIC_CONSULTATION_ENDPOINT=/consultation
PUBLIC_AUDIO_UPLOAD_ENDPOINT=/audio/upload

# Analytics
UMAMI_WEBSITE_ID=
# Umami base for script/ingest URLs:
#  - same-origin path prefix (e.g. /umami) proxied by Caddy to the analytics
#    upstream (production mode; the upstream hostname lives only in
#    deploy/Caddyfile and no CSP change is ever needed to move it)
#  - absolute URL (e.g. https://cloud.umami.is) for direct cross-origin loading
#  - unset defaults to https://cloud.umami.is
PUBLIC_UMAMI_BASE=
# Umami recorder (session replay) website ID (defaults to the production recorder ID)
UMAMI_RECORDER_WEBSITE_ID=
