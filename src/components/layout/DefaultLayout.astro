---
import LanguageSwitcher from "../ui/LanguageSwitcher.astro";
import SEO from "./SEO.astro";
import { getLocaleData, getRoutes } from "src/locales";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/space-grotesk/wght.css";

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  ogImage?: string;
  locale: string;
}

const { title, description, activeNav = "", ogImage, locale } = Astro.props;
const data = getLocaleData(locale);
const routes = getRoutes();
const pageUrl = Astro.url.pathname;

const umamiWebsiteId = import.meta.env.UMAMI_WEBSITE_ID;
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL || "https://cloud.umami.is/script.js";
const umamiRecorderWebsiteId =
  import.meta.env.UMAMI_RECORDER_WEBSITE_ID ||
  "230d6bff-1c5c-4a19-934f-476709d63f33";

const normalizedPath = pageUrl.replace(/\/$/, "") || "/";
let currentRouteKey: string | null = null;
for (const [key, routePath] of Object.entries(data.routes)) {
  if (
    routePath === normalizedPath ||
    routePath.replace(/\/$/, "") === normalizedPath
  ) {
    currentRouteKey = key;
    break;
  }
}
const routeKey = currentRouteKey as keyof typeof routes.en | null;
const canonicalEn = routeKey ? routes.en[routeKey] || "/en/" : "/en/";
const canonicalEs = routeKey ? routes.es[routeKey] || "/" : "/";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="e0CYivTL-sbhZAX7g7aUGMI6tPHKgqCS3SF73fKU4No" />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      locale={locale}
    />
    <link rel="preload" as="image" href="/crow-electricity.webp" fetchpriority="high" />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(canonicalEn, Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(canonicalEs, Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={Astro.site}
    />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cloud.umami.is https://latitudem2m-analytics.chrislabs.net 'unsafe-inline' 'unsafe-hashes' 'unsafe-eval'; img-src 'self' https://images.unsplash.com data:; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; media-src 'self' blob:; connect-src 'self' https://crowsys.chrislabs.net https://latitudem2m-analytics.chrislabs.net; object-src 'none'; base-uri 'self';" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/android-chrome-192x192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/android-chrome-512x512.png"
    />
    {
      umamiWebsiteId && (
        <script
          defer
          src={umamiUrl}
          data-website-id={umamiWebsiteId}
          data-performance="true"
        />
      )
    }
    {
      umamiWebsiteId && (
        <script
          defer
          src="https://latitudem2m-analytics.chrislabs.net/recorder.js"
          data-website-id={umamiRecorderWebsiteId}
        />
      )
    }
  </head>
  <body
    class="bg-surface text-on-surface selection:bg-primary/20 font-body grid-bg min-h-screen"
  >
    <nav
      class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-md border-b border-outline-variant/30"
      role="navigation"
      aria-label="Main navigation"
    >
      <div
        class="flex justify-between items-center w-full px-6 md:px-8 py-4 max-w-7xl mx-auto"
      >
        <div class="flex items-center gap-6">
          <button
            class="md:hidden p-2 text-on-surface"
            aria-label="Toggle menu"
            id="menu-btn"
            data-umami-event="mobile-menu-toggle"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path></svg
            >
          </button>
          <a
            href={data.routes.home}
            data-umami-event="nav-home"
            class="font-heading text-xl font-black tracking-tighter text-primary"
            aria-label="Crow Systems Home">CROW SYSTEMS</a
          >
          <div class="hidden md:flex items-center gap-6">
            <a
              href={data.routes.services}
              data-umami-event="nav-services"
              class={`text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm ${activeNav === data.nav.services ? "text-primary font-bold border-b-2 border-primary pb-1" : ""}`}
              >{data.nav.services}</a
            >
            <a
              href={data.routes.consulting}
              data-umami-event="nav-consulting"
              class={`text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm ${activeNav === data.nav.consulting ? "text-primary font-bold border-b-2 border-primary pb-1" : ""}`}
              >{data.nav.consulting}</a
            >
            <a
              href={data.routes.about}
              data-umami-event="nav-about"
              class={`text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm ${activeNav === data.nav.about ? "text-primary font-bold border-b-2 border-primary pb-1" : ""}`}
              >{data.nav.about}</a
            >
            <a
              href={data.routes.contact}
              data-umami-event="nav-contact"
              class={`text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm ${activeNav === data.nav.contact ? "text-primary font-bold border-b-2 border-primary pb-1" : ""}`}
              >{data.nav.contact}</a
            >
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="hidden md:block">
            <LanguageSwitcher />
          </div>
          <a
            href={data.routes.consulting}
            data-umami-event="nav-get-started"
            class="ml-auto bg-primary text-white font-bold px-5 py-2 rounded-lg text-sm hover:bg-primary/90 transition-all active:scale-95 shadow-sm text-center"
            style="width: 120px;"
          >
            {data.nav.getStarted}
          </a>
        </div>
      </div>
      <div
        id="mobile-menu"
        class="md:hidden hidden border-t border-outline-variant/30 bg-surface"
      >
        <div class="px-6 py-4 space-y-3">
          <a
            href={data.routes.services}
            data-umami-event="mobile-nav-services"
            class={`block text-on-surface-variant hover:text-primary text-sm font-medium py-1 ${activeNav === data.nav.services ? "text-primary font-bold" : ""}`}
            >{data.nav.services}</a
          >
          <a
            href={data.routes.consulting}
            data-umami-event="mobile-nav-consulting"
            class={`block text-on-surface-variant hover:text-primary text-sm font-medium py-1 ${activeNav === data.nav.consulting ? "text-primary font-bold" : ""}`}
            >{data.nav.consulting}</a
          >
          <a
            href={data.routes.about}
            data-umami-event="mobile-nav-about"
            class={`block text-on-surface-variant hover:text-primary text-sm font-medium py-1 ${activeNav === data.nav.about ? "text-primary font-bold" : ""}`}
            >{data.nav.about}</a
          >
          <a
            href={data.routes.contact}
            data-umami-event="mobile-nav-contact"
            class={`block text-on-surface-variant hover:text-primary text-sm font-medium py-1 ${activeNav === data.nav.contact ? "text-primary font-bold" : ""}`}
            >{data.nav.contact}</a
          >
          <div class="pt-3 mt-3 border-t border-outline-variant/30">
            <LanguageSwitcher />
          </div>
        </div>
      </div>
    </nav>

    <main class="pt-28">
      <slot />
    </main>

    <footer
      class="bg-surface-container-low border-t border-outline-variant/20"
      role="contentinfo"
    >
      <div
        class="flex flex-col md:flex-row justify-between items-center w-full px-6 md:px-8 py-10 max-w-7xl mx-auto gap-6"
      >
        <div class="flex flex-col gap-2">
          <span class="font-heading text-base font-bold text-primary"
            >CROW SYSTEMS</span
          >
          <p class="font-body text-sm text-on-surface-variant">
            {data.footer.copyright}
          </p>
        </div>
        <div class="flex gap-6 flex-wrap justify-center">
          <a
            href={data.routes.privacy}
            data-umami-event="footer-privacy"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors"
            >{data.footer.privacy}</a
          >
          <a
            href={data.routes.terms}
            data-umami-event="footer-terms"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors"
            >{data.footer.terms}</a
          >
        </div>
        <div class="flex gap-4 flex-wrap justify-center">
          <a
            href="https://www.linkedin.com/company/crowsysmx"
            data-umami-event="footer-linkedin"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors capitalize"
            target="_blank"
            rel="noopener noreferrer">{data.footer.linkedin}</a
          >
          <a
            href="https://www.x.com/crowsysmx"
            data-umami-event="footer-twitter"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors capitalize"
            target="_blank"
            rel="noopener noreferrer">{data.footer.twitter}</a
          >
          <a
            href="https://www.instagram.com/crowsysmx"
            data-umami-event="footer-instagram"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors capitalize"
            target="_blank"
            rel="noopener noreferrer">{data.footer.instagram}</a
          >
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        let menuOpen = false;
        const menu = document.getElementById("mobile-menu");
        document.getElementById("menu-btn")?.addEventListener("click", (e) => {
          e.stopPropagation();
          menuOpen = !menuOpen;
          if (menuOpen) {
            menu?.classList.remove("hidden");
          } else {
            menu?.classList.add("hidden");
          }
        });
        menu?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            menuOpen = false;
            menu.classList.add("hidden");
          });
        });
      })();
    </script>
  <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
      <div
        id="whatsapp-card"
        role="dialog"
        aria-label={data.common.whatsappLabel}
        class="hidden w-80 max-w-[calc(100vw-3rem)] bg-white rounded-2xl shadow-xl border border-outline-variant/30 p-4"
      >
        <p class="text-xs font-bold text-on-surface-variant mb-2">
          {data.common.whatsappQuestion}
        </p>
        <div class="flex flex-wrap gap-2 mb-3">
          {
            data.common.whatsappSuggestions.map((s) => (
              <button
                type="button"
                data-whatsapp-suggestion={s.message}
                data-whatsapp-label={s.label}
                aria-pressed="false"
                class="flex items-center gap-1.5 text-xs p-2 rounded-full border border-outline-variant/40 bg-surface-container-low hover:bg-primary/10 hover:text-primary transition-colors"
              >
                <span class="hidden whatsapp-check text-white" aria-hidden="true"
                  ><svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><polyline points="20 6 9 17 4 12"></polyline></svg
                  ></span
                >
                {s.label}
              </button>
            ))
          }
        </div>
        <label
          for="whatsapp-msg"
          class="sr-only"
          >{data.common.whatsappLabel}</label
        >
        <textarea
          id="whatsapp-msg"
          rows="5"
          class="w-full resize-none rounded-lg border border-outline-variant/40 p-2 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/40"
          placeholder={data.common.whatsappPlaceholder}
        >{data.common.whatsappMessage}</textarea>
        <a
          id="whatsapp-send"
          href={`https://wa.me/526645492359?text=${encodeURIComponent(data.common.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full block text-center bg-[#25D366] text-white font-bold rounded-lg py-2 text-sm hover:bg-[#1fb958] transition-colors mt-3"
        >
          {data.common.whatsappSend}
        </a>
      </div>
      <button
        id="whatsapp-fab"
        type="button"
        aria-label={data.common.whatsappLabel}
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-controls="whatsapp-card"
        class="relative flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] text-white shadow-lg hover:scale-110 active:scale-95 transition-transform"
        ><span
          id="whatsapp-badge"
          aria-hidden="true"
          class="hidden absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-red-500 ring-2 ring-white"
        ></span>
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="currentColor"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg
        ></button
      >
    </div>

    <script is:inline>
      (() => {
        const fab = document.getElementById("whatsapp-fab");
        const card = document.getElementById("whatsapp-card");
        const msg = document.getElementById("whatsapp-msg");
        const send = document.getElementById("whatsapp-send");
        const badge = document.getElementById("whatsapp-badge");
        const base = "https://wa.me/526645492359?text=";
        const track = (name, data) =>
          window.umami?.track?.(name, data) || undefined;
        const defaultValue = msg.value;
        const sync = () => {
          send.href = base + encodeURIComponent(msg.value);
        };
        const updateBadge = () => {
          const pending =
            msg.value !== defaultValue && card.classList.contains("hidden");
          badge.classList.toggle("hidden", !pending);
        };
        const close = () => {
          card.classList.add("hidden");
          fab.setAttribute("aria-expanded", "false");
          updateBadge();
          track("whatsapp-close");
        };
        const open = () => {
          card.classList.remove("hidden");
          fab.setAttribute("aria-expanded", "true");
          updateBadge();
          msg.focus();
          msg.setSelectionRange(msg.value.length, msg.value.length);
          track("whatsapp-open");
        };
        let active = null;
        const ACTIVE_CLASSES = ["bg-primary", "text-white", "border-primary"];
        const setActive = (pill) => {
          if (active) {
            active.classList.remove(...ACTIVE_CLASSES);
            active.setAttribute("aria-pressed", "false");
            active.querySelector(".whatsapp-check").classList.add("hidden");
          }
          active = pill || null;
          if (active) {
            active.classList.add(...ACTIVE_CLASSES);
            active.setAttribute("aria-pressed", "true");
            active.querySelector(".whatsapp-check").classList.remove("hidden");
          }
        };
        msg.addEventListener("input", () => {
          if (active && msg.value !== active.dataset.whatsappSuggestion) {
            setActive(null);
          }
          sync();
          updateBadge();
        });
        card.querySelectorAll("[data-whatsapp-suggestion]").forEach((pill) => {
          pill.addEventListener("click", () => {
            setActive(pill);
            msg.value = pill.dataset.whatsappSuggestion;
            msg.focus();
            msg.setSelectionRange(msg.value.length, msg.value.length);
            sync();
            updateBadge();
            track("whatsapp-suggestion", { label: pill.dataset.whatsappLabel });
          });
        });
        send.addEventListener("click", (e) => {
          if (!msg.value.trim()) {
            e.preventDefault();
            msg.focus();
            return;
          }
          track("whatsapp-send");
          setActive(null);
          msg.value = defaultValue;
          sync();
          updateBadge();
        });
        fab.addEventListener("click", () => {
          if (card.classList.contains("hidden")) open();
          else close();
        });
        document.addEventListener("click", (e) => {
          if (card.classList.contains("hidden")) return;
          if (e.target.closest("#whatsapp-card, #whatsapp-fab")) return;
          close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !card.classList.contains("hidden")) {
            close();
            fab.focus();
          }
        });
        sync();
      })();
    </script>
  </body>
</html>
