---
interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  ogImage?: string;
}

const { title, description, activeNav = "", ogImage } = Astro.props;

const NAV_ITEMS = [
  { label: "Services", href: "/services" },
  { label: "Consulting", href: "/consulting" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const pageUrl = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://crowsys.chrislabs.net${pageUrl}`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`https://crowsys.chrislabs.net${pageUrl}`}
    />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <title>{title}</title>
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/android-chrome-192x192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/android-chrome-512x512.png"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/_astro/index.B74nlT63.css" />
  </head>
  <body
    class="bg-surface text-on-surface selection:bg-primary/20 font-body grid-bg min-h-screen"
  >
    <nav
      class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-md border-b border-outline-variant/30"
      role="navigation"
      aria-label="Main navigation"
    >
      <div
        class="flex justify-between items-center w-full px-6 md:px-8 py-4 max-w-7xl mx-auto"
      >
        <div class="flex items-center gap-6">
          <button
            class="md:hidden p-2 text-on-surface"
            aria-label="Toggle menu"
            id="menu-btn"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path></svg
            >
          </button>
          <a
            href="/"
            class="font-heading text-xl font-black tracking-tighter text-primary"
            aria-label="Crow Systems Home">CROW SYSTEMS</a
          >
          <div class="hidden md:flex items-center gap-6">
            {
              NAV_ITEMS.map((item) => {
                const isActive = activeNav === item.label;
                return (
                  <a
                    href={item.href}
                    class={`text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm ${isActive ? "text-primary font-bold border-b-2 border-primary pb-1" : ""}`}
                  >
                    {item.label}
                  </a>
                );
              })
            }
          </div>
        </div>
        <a
          href="/consulting"
          class="ml-auto bg-primary text-white font-bold px-5 py-2 rounded-lg text-sm hover:bg-primary/90 transition-all active:scale-95 shadow-sm"
          >Get Started</a
        >
      </div>
      <div
        id="mobile-menu"
        class="md:hidden hidden border-t border-outline-variant/30 bg-surface"
      >
        <div class="px-6 py-4 space-y-3">
          {
            NAV_ITEMS.map((item) => {
              const isActive = activeNav === item.label;
              return (
                <a
                  href={item.href}
                  class={`block text-on-surface-variant hover:text-primary text-sm font-medium py-1 ${isActive ? "text-primary font-bold" : ""}`}
                >
                  {item.label}
                </a>
              );
            })
          }
        </div>
      </div>
    </nav>

    <main class="pt-28">
      <slot />
    </main>

    <footer
      class="bg-surface-container-low border-t border-outline-variant/20"
      role="contentinfo"
    >
      <div
        class="flex flex-col md:flex-row justify-between items-center w-full px-6 md:px-8 py-10 max-w-7xl mx-auto gap-6"
      >
        <div class="flex flex-col gap-2">
          <span class="font-heading text-base font-bold text-primary"
            >CROW SYSTEMS</span
          >
          <p class="font-body text-sm text-on-surface-variant">
            &copy; 2024 Crow Systems. Engineering Solutions for Growing
            Businesses.
          </p>
        </div>
        <div class="flex gap-6 flex-wrap justify-center">
          <a
            href="/about"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors"
            >About</a
          >
          <a
            href="/services"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors"
            >Services</a
          >
          <a
            href="/contact"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors"
            >Contact</a
          >
          <a
            href="/privacy"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors"
            >Privacy Policy</a
          >
          <a
            href="/terms"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors"
            >Terms of Service</a
          >
        </div>
        <div class="flex gap-4 flex-wrap justify-center">
          <a
            href="https://www.linkedin.com/company/crowsystems"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors capitalize"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <a
            href="https://www.x.com/@crowsystems"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors capitalize"
            target="_blank"
            rel="noopener noreferrer">Twitter/X</a
          >
          <a
            href="https://www.instagram.com/@crowsystems"
            class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors capitalize"
            target="_blank"
            rel="noopener noreferrer">Instagram</a
          >
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        let menuOpen = false;
        const menu = document.getElementById("mobile-menu");
        document.getElementById("menu-btn")?.addEventListener("click", (e) => {
          e.stopPropagation();
          menuOpen = !menuOpen;
          if (menuOpen) {
            menu?.classList.remove("hidden");
          } else {
            menu?.classList.add("hidden");
          }
        });
        // Close menu when a nav link is clicked
        menu?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            menuOpen = false;
            menu.classList.add("hidden");
          });
        });
      })();
    </script>
  </body>
</html>
