---
import en from "../../locales/en.json";
import es from "../../locales/es.json";

const locale = Astro.url.pathname.split("/")[1] === "es" ? "es" : "en";
const otherLocale = locale === "en" ? "es" : "en";
const localeLabel = locale === "en" ? "ES" : "EN";
const currentLabel = locale === "en" ? "EN" : "ES";
const data = locale === "es" ? es : en;
const otherData = otherLocale === "es" ? es : en;

const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
let currentRouteKey: string | null = null;
for (const [key, routePath] of Object.entries(data.routes)) {
  if (routePath === normalizedPath || routePath.replace(/\/$/, "") === normalizedPath) {
    currentRouteKey = key;
    break;
  }
}
const otherPath = currentRouteKey && otherData.routes[currentRouteKey]
  ? otherData.routes[currentRouteKey]
  : otherLocale === "en" ? "/" : "/es/";
---

<div class="flex items-center gap-2" role="group" aria-label="Language selector">
  <span class="text-xs text-on-surface-variant/60 uppercase tracking-wider font-semibold">
    {currentLabel}
  </span>
  <a
    href={otherPath}
    class="text-xs font-bold text-primary hover:text-accent transition-colors duration-300 uppercase tracking-wider px-2 py-1 rounded-md hover:bg-primary/10"
    aria-label={`Switch to ${otherLocale === "en" ? "English" : "Español"}`}
  >
    {localeLabel}
  </a>
</div>
