---
import { getAnchorMap, getLocaleData, getRoutes } from "src/locales";

const locale = Astro.url.pathname.split("/")[1] === "en" ? "en" : "es";
const data = getLocaleData(locale);
const routes = getRoutes();
const anchorMap: Record<string, string> = getAnchorMap();

const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
let currentRouteKey: string | null = null;
for (const [key, routePath] of Object.entries(data.routes)) {
  if (
    routePath === normalizedPath ||
    routePath.replace(/\/$/, "") === normalizedPath
  ) {
    currentRouteKey = key;
    break;
  }
}
const routeKey = currentRouteKey as keyof typeof routes.en | null;
const enPath = routeKey && routes.en[routeKey] ? routes.en[routeKey] : "/en/";
const esPath = routeKey && routes.es[routeKey] ? routes.es[routeKey] : "/";
---

<div
  class="inline-flex items-center gap-px bg-surface-container/80 rounded-full p-1 shadow-sm shadow-black/5"
  role="radiogroup"
  aria-label="Language selector"
  data-anchor-map={JSON.stringify(anchorMap)}
>
  <a
    href={enPath}
    data-umami-event="lang-switch"
    data-umami-event-lang="en"
    class={`${locale === "en" ? "bg-primary text-white shadow-sm shadow-black/10" : "text-on-surface-variant hover:bg-primary/10"} text-[10px] font-bold uppercase tracking-wider px-3 py-1.5 rounded-full transition-all duration-300`}
    role="radio"
    aria-checked={locale === "en"}
    aria-label="English"
  >
    EN
  </a>
  <a
    href={esPath}
    data-umami-event="lang-switch"
    data-umami-event-lang="es"
    class={`${locale === "es" ? "bg-primary text-white shadow-sm shadow-black/10" : "text-on-surface-variant hover:bg-primary/10"} text-[10px] font-bold uppercase tracking-wider px-3 py-1.5 rounded-full transition-all duration-300`}
    role="radio"
    aria-checked={locale === "es"}
    aria-label="Español"
  >
    ES
  </a>
</div>

<script>
  const anchorMapEl = document.querySelector<HTMLElement>("[data-anchor-map]");
  const anchorMap: Record<string, string> = anchorMapEl
    ? (JSON.parse(anchorMapEl.dataset.anchorMap || "{}") as Record<string, string>)
    : {};
  const w = window as Window & { __anchorPreserved?: boolean };
  if (!w.__anchorPreserved) {
    w.__anchorPreserved = true;
    document
      .querySelectorAll<HTMLAnchorElement>('[data-umami-event="lang-switch"]')
      .forEach((link) => {
        link.addEventListener("click", (e) => {
          const hash = window.location.hash;
          if (!hash) return;
          e.preventDefault();
          window.location.assign(link.href + (anchorMap[hash] || hash));
        });
      });
  }
</script>
