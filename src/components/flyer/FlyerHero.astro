---
import { sanitizeHtml } from "../../scripts/sanitize";

interface Props {
  eyebrow: string;
  heading: string;
  heroDescription: string;
  cta: string;
}

const { eyebrow, heading, heroDescription, cta } = Astro.props;
---

<div class="bg-white border border-[#e2e6f0] rounded-2xl px-5 pt-6 pb-5 mb-4">
  <div class="text-xs font-semibold text-[#378ADD] tracking-[2px] uppercase mb-3">{eyebrow}</div>
  <h1 class="text-2xl font-extrabold leading-tight text-[#1a1f36] mb-3" set:html={sanitizeHtml(heading)} />
  <p class="text-xs text-[#6b7694] leading-relaxed mb-5">{heroDescription}</p>
  <div class="inline-flex items-center gap-2 bg-[#185FA5] text-white text-xs font-semibold px-5 py-3 rounded-lg tracking-[.3px]">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg> {cta}
  </div>
</div>
