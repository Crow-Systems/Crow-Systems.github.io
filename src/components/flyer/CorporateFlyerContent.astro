---
import FlyerHeader from "./FlyerHeader.astro";
import FlyerHero from "./FlyerHero.astro";
import FlyerServices from "./FlyerServices.astro";
import FlyerServiceCard from "./FlyerServiceCard.astro";
import FlyerFooter from "./FlyerFooter.astro";
import FlyerDownloadButton from "./FlyerDownloadButton.astro";

interface FlyerContent {
  tagline: string;
  hiringBadge?: string;
  eyebrow: string;
  heading: string;
  heroDescription: string;
  cta: string;
  service1Title: string;
  service1Desc: string;
  service2Title: string;
  service2Desc: string;
  service3Title: string;
  service3Desc: string;
  service4Title: string;
  service4Desc: string;
  service5Title: string;
  service5Desc: string;
  service6Title: string;
  service6Desc: string;
  footerHeadline: string;
  footerSubheadline: string;
  qrLabel: string;
}

interface Props {
  content: FlyerContent;
  origin: string;
  qrUrl: string;
  downloadLabel: string;
}

const { content, origin, qrUrl, downloadLabel } = Astro.props;
---

<div class="flex justify-center flex-col">
  <div class="flex justify-center">
    <div id="flyer" data-qr-url={qrUrl} class="font-['Inter',sans-serif] bg-[#f7f8fc] w-full max-w-2xl rounded-3xl border border-[#e2e6f0] text-[#1a1f36] p-8">
      <FlyerHeader tagline={content.tagline} />

      <FlyerHero
        eyebrow={content.eyebrow}
        heading={content.heading}
        heroDescription={content.heroDescription}
        cta={content.cta}
      />

      <FlyerServices>
        <FlyerServiceCard
          iconSvg={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" stroke-width="2" stroke="#185FA5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 8l-4 4l4 4"/><path d="M17 8l4 4l-4 4"/><path d="M14 4l-4 16"/></svg>`}
          iconBg="bg-[#E6F1FB]"
          iconColor="text-[#185FA5]"
          title={content.service1Title}
          desc={content.service1Desc}
        />
        <FlyerServiceCard
          iconSvg={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" stroke-width="2" stroke="#534AB7" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 19l16 0"/><path d="M4 15l4 -6l4 2l4 -5l4 4"/></svg>`}
          iconBg="bg-[#EEEDFE]"
          iconColor="text-[#534AB7]"
          title={content.service2Title}
          desc={content.service2Desc}
        />
        <FlyerServiceCard
          iconSvg={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" stroke-width="2" stroke="#0F6E56" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/><path d="M12 11m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/><path d="M12 12l0 2.5"/></svg>`}
          iconBg="bg-[#E1F5EE]"
          iconColor="text-[#0F6E56]"
          title={content.service3Title}
          desc={content.service3Desc}
        />
        <FlyerServiceCard
          iconSvg={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" stroke-width="2" stroke="#854F0B" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 13a8 8 0 0 1 7 7a6 6 0 0 0 3 -5a9 9 0 0 0 6 -8a3 3 0 0 0 -3 -3a9 9 0 0 0 -8 6a6 6 0 0 0 -5 3"/><path d="M7 14a6 6 0 0 0 -3 6a6 6 0 0 0 6 -3"/><path d="M15 9m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/></svg>`}
          iconBg="bg-[#FAEEDA]"
          iconColor="text-[#854F0B]"
          title={content.service4Title}
          desc={content.service4Desc}
        />
        <FlyerServiceCard
          iconSvg={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" stroke-width="2" stroke="#993C1D" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M18 8a3 3 0 0 1 0 6"/><path d="M10 8v11a1 1 0 0 1 -1 1h-1a1 1 0 0 1 -1 -1v-5"/><path d="M12 8h0l4.524 -3.77a.9 .9 0 0 1 1.476 .692v12.156a.9 .9 0 0 1 -1.476 .692l-4.524 -3.77h-8a1 1 0 0 1 -1 -1v-4a1 1 0 0 1 1 -1h8"/></svg>`}
          iconBg="bg-[#FAECE7]"
          iconColor="text-[#993C1D]"
          title={content.service5Title}
          desc={content.service5Desc}
        />
        <FlyerServiceCard
          iconSvg={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" stroke-width="2" stroke="#B8661A" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 7l-8 -4l-8 4"/><path d="M20 7l-8 4l-8 -4"/><path d="M4 7v9l8 4l8 -4v-9"/><path d="M16 10l-1 -0.5"/></svg>`}
          iconBg="bg-[#FDF0E6]"
          iconColor="text-[#B8661A]"
          title={content.service6Title}
          desc={content.service6Desc}
        />
      </FlyerServices>

      <hr class="border-0 border-t border-[#e8eaf2]">
      <div class="h-4"></div>

      <FlyerFooter
        footerHeadline={content.footerHeadline}
        footerSubheadline={content.footerSubheadline}
        origin={origin}
        qrLabel={content.qrLabel}
      />
    </div>
  </div>
  <FlyerDownloadButton downloadLabel={downloadLabel} />
</div>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@800&display=swap" rel="stylesheet" />
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" integrity="sha384-3zSEDfvllQohrq0PHL1fOXJuC/jSOO34H46t6UQfobFOmxE5BpjjaIJY5F2/bMnU" crossorigin="anonymous"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js" integrity="sha384-UbfRVKN3/elS1r7JcK2FhmPP+KlJ4CvYwbyYD7tH+uTkbT9bNJr9eJeQ0FoFbAgz" crossorigin="anonymous"></script>
<script is:inline>
  new QRCode(document.getElementById('qr-container'), {
    text: document.getElementById('flyer').getAttribute('data-qr-url'),
    width: 96,
    height: 96,
    colorDark: '#185FA5',
    colorLight: '#ffffff',
    correctLevel: QRCode.CorrectLevel.M
  });

  document.getElementById('download-btn').addEventListener('click', async function () {
    await document.fonts.ready;

    const el = document.getElementById('flyer');
    const dataUrl = await htmlToImage.toJpeg(el, {
      quality: 0.92,
      backgroundColor: '#f7f8fc',
      pixelRatio: 2,
    });

    window.umami?.track('flyer-download-complete');

    const link = document.createElement('a');
    link.download = 'crow-systems-flyer.jpg';
    link.href = dataUrl;
    link.click();
  });
</script>
