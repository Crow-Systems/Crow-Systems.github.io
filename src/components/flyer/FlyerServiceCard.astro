---
interface Props {
  iconSvg: string;
  iconBg: string;
  iconColor: string;
  title: string;
  desc: string;
  fullWidth?: boolean;
}

const { iconSvg, iconBg, iconColor, title, desc, fullWidth } = Astro.props;
const colClass = fullWidth ? "col-span-2" : "";
---

<div class={`bg-white border border-[#e2e6f0] rounded-2xl px-5 py-5 ${colClass}`}>
  <div class="flex items-start gap-4">
    <div class={`w-10 h-10 rounded-xl ${iconBg} ${iconColor} flex items-center justify-center shrink-0`} set:html={iconSvg} />
    <div class="min-w-0">
      <div class="text-sm font-bold text-[#1a1f36] mb-1 leading-tight">{title}</div>
      <div class="text-[11px] text-[#6b7694] leading-relaxed">{desc}</div>
    </div>
  </div>
</div>
