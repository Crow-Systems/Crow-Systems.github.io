---
interface Props {
  iconClass: string;
  iconBg: string;
  iconColor: string;
  title: string;
  desc: string;
  fullWidth?: boolean;
}

const { iconClass, iconBg, iconColor, title, desc, fullWidth = false } = Astro.props;
---

{
  fullWidth ? (
    <div class="col-span-full flex items-center gap-4 bg-white border border-[#e2e6f0] rounded-xl p-4">
      <div class={`w-8 h-8 rounded-lg flex items-center justify-center mb-2 text-lg flex-shrink-0 ${iconBg} ${iconColor}`}>
        <i class={iconClass} aria-hidden="true"></i>
      </div>
      <div>
        <div class="text-xs font-bold text-[#1a1f36] mb-1">{title}</div>
        <div class="text-[10px] text-[#8a93aa] leading-relaxed">{desc}</div>
      </div>
    </div>
  ) : (
    <div class="bg-white border border-[#e2e6f0] rounded-xl px-4 pb-3 pt-3 flex gap-4">
      <div class={`w-8 h-8 rounded-lg flex items-center justify-center mb-2 text-lg flex-shrink-0 ${iconBg} ${iconColor}`}>
        <i class={iconClass} aria-hidden="true"></i>
      </div>
      <div>
        <div class="text-xs font-bold text-[#1a1f36] mb-1">{title}</div>
        <div class="text-[10px] text-[#8a93aa] leading-relaxed">{desc}</div>
      </div>
    </div>
  )
}
