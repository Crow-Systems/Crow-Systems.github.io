---
import { getLocaleData } from "src/locales";
import DefaultLayout from "../components/layout/DefaultLayout.astro";
import { sanitizeHtml } from "../scripts/sanitize";

const locale = Astro.url.pathname.split("/")[1] === "en" ? "en" : "es";
const data = getLocaleData(locale);
---

<DefaultLayout
  title={data.pages.about.title}
  description={data.pages.about.description}
  activeNav={data.nav.about}
  locale={locale}
>
  <section
    class="pt-32 pb-24 px-6 md:px-8 max-w-7xl mx-auto"
    aria-labelledby="about-heading"
  >
    <div class="space-y-8 max-w-3xl">
      <span
        class="text-accent font-bold uppercase tracking-widest text-xs mb-2 block"
        >{data.pages.about.whoWeAre}</span
      >
      <h1
        id="about-heading"
        class="font-heading text-4xl md:text-5xl font-bold text-on-surface tracking-tight mb-6"
        set:html={sanitizeHtml(data.pages.about.heading)}
      />
      <p class="text-on-surface-variant leading-relaxed font-body text-lg">
        {data.pages.about.description1}
      </p>
      <p class="text-on-surface-variant leading-relaxed font-body text-lg">
        {data.pages.about.description2}
      </p>
    </div>
  </section>

  <section
    class="pt-24 pb-24 px-6 md:px-8 max-w-7xl mx-auto"
    aria-labelledby="mission-heading"
  >
    <h2
      id="mission-heading"
      class="font-heading text-3xl font-bold text-on-surface text-center mb-12"
    >
      {data.pages.about.missionVision}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div
        class="bg-surface-container-lowest p-10 rounded-xl border border-outline-variant/30 hover:border-primary/50 transition-all shadow-sm hover:shadow-md"
      >
        <div
          class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-8 transition-transform hover:scale-110"
        >
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-primary"
            ><path d="M9 11l3 3L22 4"></path><path
              d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"
            ></path></svg
          >
        </div>
        <h3 class="font-heading text-2xl font-bold mb-4 text-on-surface">
          {data.pages.about.mission}
        </h3>
        <p class="text-on-surface-variant leading-relaxed font-body text-sm">
          {data.pages.about.missionText}
        </p>
      </div>
      <div
        class="bg-surface-container-lowest p-10 rounded-xl border border-outline-variant/30 hover:border-primary/50 transition-all shadow-sm hover:shadow-md"
      >
        <div
          class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center mb-8 transition-transform hover:scale-110"
        >
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-accent"
            ><circle cx="12" cy="12" r="10"></circle><path
              d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"></path><circle
              cx="12"
              cy="12"
              r="3"></circle></svg
          >
        </div>
        <h3 class="font-heading text-2xl font-bold mb-4 text-on-surface">
          {data.pages.about.vision}
        </h3>
        <p class="text-on-surface-variant leading-relaxed font-body text-sm">
          {data.pages.about.visionText}
        </p>
      </div>
      <div
        class="bg-surface-container-lowest p-10 rounded-xl border border-outline-variant/30 hover:border-primary/50 transition-all shadow-sm hover:shadow-md"
      >
        <div
          class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-8 transition-transform hover:scale-110"
        >
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="text-primary"
            ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
        </div>
        <h3 class="font-heading text-2xl font-bold mb-4 text-on-surface">
          {data.pages.about.values}
        </h3>
        <ul class="space-y-3 text-on-surface-variant text-sm font-body">
          {
            data.pages.about.valueItems.map((value) => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-accent rounded-full" /> {value}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    class="pt-24 pb-24 px-6 md:px-8 max-w-7xl mx-auto"
    aria-labelledby="expertise-heading"
  >
    <h2
      id="expertise-heading"
      class="font-heading text-3xl font-bold text-on-surface text-center mb-12"
    >
      {data.pages.about.expertise}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div
        class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-8"
      >
        <h4 class="font-heading text-xl font-bold text-on-surface mb-4">
          {data.pages.about.networking.title}
        </h4>
        <p
          class="text-on-surface-variant text-sm leading-relaxed font-body mb-4"
        >
          {data.pages.about.networking.description}
        </p>
        <ul
          class="space-y-2 text-sm text-on-surface-variant font-body list-disc pl-5"
        >
          {
            [0, 1, 2, 3, 4, 5, 6].map((i) => (
              <li>{data.pages.about.networking.items[i]}</li>
            ))
          }
        </ul>
      </div>
      <div
        class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-8"
      >
        <h4 class="font-heading text-xl font-bold text-on-surface mb-4">
          {data.pages.about.software.title}
        </h4>
        <p
          class="text-on-surface-variant text-sm leading-relaxed font-body mb-4"
        >
          {data.pages.about.software.description}
        </p>
        <ul
          class="space-y-2 text-sm text-on-surface-variant font-body list-disc pl-5"
        >
          {
            [0, 1, 2, 3, 4, 5, 6].map((i) => (
              <li>{data.pages.about.software.items[i]}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    id={data.pages.about.teamAnchorId}
    class="pt-24 pb-24 px-6 md:px-8 max-w-7xl mx-auto"
    aria-labelledby="team-heading"
  >
    <h2
      id="team-heading"
      class="font-heading text-3xl font-bold text-on-surface text-center mb-4"
    >
      {data.pages.about.meetTheTeam}
    </h2>
    <p
      class="text-on-surface-variant font-body text-center text-lg mb-12 max-w-2xl mx-auto"
    >
      {data.pages.about.meetTheTeamIntro}
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 max-w-5xl mx-auto">
      {
        data.pages.about.founders.map((founder) => (
          <div class="flex flex-col items-center text-center">
            <div
              class="w-64 aspect-[4/5] rounded-2xl overflow-hidden border border-outline-variant/30 shadow-sm bg-surface-container-high"
            >
              <img
                alt={founder.name}
                class="w-full h-full object-cover"
                src={founder.photo}
              />
            </div>
            <h3 class="font-heading text-2xl font-bold text-on-surface mt-6">
              {founder.name}
            </h3>
            <p
              class="text-accent font-bold uppercase tracking-widest text-xs mt-2"
            >
              {founder.title}
            </p>
            <p
              class="text-on-surface-variant leading-relaxed font-body text-sm mt-4 max-w-sm"
            >
              {founder.role}
            </p>
            <a
              href={founder.linkedin}
              target="_blank"
              data-umami-event="team-linkedin"
              class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                ><path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
                ></path></svg
              >
              LinkedIn
            </a>
          </div>
        ))
      }
    </div>
  </section>
</DefaultLayout>
