---
import DefaultLayout from '../components/layout/DefaultLayout.astro';

const COMPANY_DESCRIPTION = 'We are a specialized engineering team focused on transforming complex technical challenges into practical, scalable, and reliable solutions for growing businesses. Our mission is to help companies reduce technical complexity, improve operational efficiency, accelerate development, and confidently bring new ideas to life.';

const STATS_DATA = [
  { value: '240+', label: 'Projects Delivered', desc: 'Across industries and technologies' },
  { value: '99%', label: 'System Uptime', desc: 'Reliable infrastructure you can count on' },
  { value: '15+', label: 'Senior Engineers', desc: 'Experienced hands, not junior staff' },
  { value: '4hrs', label: 'Avg. Response Time', desc: 'Fast triage, rapid engagement' },
];
---

<DefaultLayout
  title="CROW SYSTEMS — Engineering Solutions for Real-World Challenges"
  description="We help companies solve technical problems that are slowing down their business. From secure communications to scalable software architecture, we provide the engineering expertise to design and deliver the right solution."
  activeNav="Services"
>
  <!-- Hero Section -->
  <section class="pt-36 pb-24 px-6 md:px-8 max-w-7xl mx-auto" aria-labelledby="hero-heading">
    <div class="max-w-4xl">
      <span class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block">Engineering Solutions for Real-World Challenges</span>
      <h1 id="hero-heading" class="font-heading text-4xl md:text-6xl font-bold tracking-tighter mb-6 text-on-surface leading-tight">
        We Help Companies<br class="hidden md:block" />
        Solve Technical Problems
      </h1>
      <p class="text-lg md:text-xl text-on-surface-variant leading-relaxed mb-10 max-w-2xl font-body">
        {COMPANY_DESCRIPTION}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/consulting" class="bg-primary text-on-primary font-bold px-8 py-4 rounded-xl hover:bg-primary/90 transition-all active:scale-[0.98] shadow-lg shadow-primary/20 text-center text-sm">Start a Consultation</a>
        <a href="/services" class="border border-primary text-primary font-bold px-8 py-4 rounded-xl hover:bg-primary/10 transition-all active:scale-[0.98] text-center text-sm">Explore Services</a>
      </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-16 pt-12 border-t border-outline-variant/30">
      <div class="text-center">
        <p class="font-heading text-2xl md:text-3xl font-bold text-primary">240+</p>
        <p class="text-xs text-on-surface-variant mt-1 font-body">Projects Delivered</p>
      </div>
      <div class="text-center">
        <p class="font-heading text-2xl md:text-3xl font-bold text-primary">99%</p>
        <p class="text-xs text-on-surface-variant mt-1 font-body">System Uptime</p>
      </div>
      <div class="text-center">
        <p class="font-heading text-2xl md:text-3xl font-bold text-primary">15+</p>
        <p class="text-xs text-on-surface-variant mt-1 font-body">Senior Engineers</p>
      </div>
      <div class="text-center">
        <p class="font-heading text-2xl md:text-3xl font-bold text-primary">4hrs</p>
        <p class="text-xs text-on-surface-variant mt-1 font-body">Avg. Response Time</p>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="mx-6 md:mx-8 mb-20 relative overflow-hidden bg-primary rounded-xl p-12 md:p-20">
    <div class="relative z-10 max-w-2xl">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-on-primary mb-4">Ready to Solve Your Technical Challenges?</h2>
      <p class="text-primary-fixed-dim text-lg mb-8 font-body">Whether you need secure system communications, scalable architecture, or expert technical guidance — we provide the engineering expertise to move your business forward.</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/consulting" class="bg-secondary text-on-secondary font-bold px-8 py-4 rounded-xl hover:brightness-110 transition-all text-center text-sm">Request a Consultation</a>
        <a href="/services" class="border border-on-primary text-on-primary px-8 py-4 rounded-xl hover:bg-on-primary/10 transition-all text-center text-sm font-bold">Our Services</a>
      </div>
    </div>
  </section>
</DefaultLayout>