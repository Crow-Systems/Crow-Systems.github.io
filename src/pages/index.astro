  <script>
    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });

    // Audio Recording Handler
    (() => {
      let mediaRecorder = null;
      let chunks = [];
      let audioBlob = null;
      let audioUrl = null;
      let timer = null;
      let duration = 0;
      let audio = null;

      const recordBtn = document.getElementById('record-btn');
      const recordIcon = document.getElementById('record-icon');
      const playBtn = document.getElementById('play-btn');
      const playIcon = document.getElementById('play-icon');
      const deleteBtn = document.getElementById('delete-rec');
      const timerEl = document.getElementById('timer');
      const submitBtn = document.getElementById('submit-audio');
      const audioForm = document.getElementById('audio-form');
      const audioError = document.getElementById('audio-error');
      const audioSuccess = document.getElementById('audio-success');
      const audioBars = document.getElementById('audio-bars');
      const recDot = document.getElementById('rec-dot');

      const formatTime = (secs) => {
        const m = Math.floor(secs / 60);
        const s = secs % 60;
        return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      };

      const animateBars = (recording) => {
        const bars = audioBars.children;
        for (let i = 0; i < bars.length; i++) {
          if (recording) {
            bars[i].classList.add('bg-primary');
            bars[i].classList.remove('bg-outline-variant/40');
            bars[i].classList.add('animate-pulse');
          } else {
            bars[i].classList.remove('bg-primary');
            bars[i].classList.add('bg-outline-variant/40');
            bars[i].classList.remove('animate-pulse');
          }
        }
      };

      recordBtn?.addEventListener('click', async () => {
        if (mediaRecorder && mediaRecorder.state === 'recording') {
          mediaRecorder.stop();
          clearInterval(timer);
          recordIcon.textContent = 'mic';
          recDot.classList.remove('bg-error', 'animate-pulse');
          recDot.classList.add('bg-accent');
          animateBars(false);
          playBtn.disabled = false;
          return;
        }

        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          const mimeTypes = ['audio/webm', 'audio/mp3', 'audio/wav', 'audio/ogg'];
          const mimeType = mimeTypes.find(t => MediaRecorder.isTypeSupported(t)) || 'audio/webm';

          mediaRecorder = new MediaRecorder(stream, { mimeType });
          chunks = [];
          duration = 0;

          mediaRecorder.ondataavailable = (e) => {
            if (e.data.size > 0) chunks.push(e.data);
          };

          mediaRecorder.onstop = () => {
            audioBlob = new Blob(chunks, { type: mimeType });
            if (audioUrl) URL.revokeObjectURL(audioUrl);
            audioUrl = URL.createObjectURL(audioBlob);
            stream.getTracks().forEach(t => t.stop());
            submitBtn.disabled = false;
          };

          mediaRecorder.start();
          recordIcon.textContent = 'stop';
          recDot.classList.remove('bg-accent');
          recDot.classList.add('bg-error', 'animate-pulse');
          playBtn.disabled = true;
          animateBars(true);

          timer = setInterval(() => {
            duration++;
            timerEl.textContent = formatTime(duration);
            if (duration >= 300) {
              mediaRecorder.stop();
              clearInterval(timer);
              recordIcon.textContent = 'mic';
              recDot.classList.remove('bg-error', 'animate-pulse');
              recDot.classList.add('bg-accent');
              animateBars(false);
              playBtn.disabled = false;
            }
          }, 1000);
        } catch (err) {
          audioError.textContent = 'Microphone access denied. Please allow microphone permission, or use text description instead.';
          audioError.classList.remove('hidden');
          recordBtn.disabled = true;
        }
      });

      playBtn?.addEventListener('click', () => {
        if (!audioUrl) return;
        if (!audio) {
          audio = new Audio();
          audio.onended = () => {
            playIcon.textContent = 'play_arrow';
          };
        }
        audio.src = audioUrl;
        audio.play();
        playIcon.textContent = 'pause';
      });

      deleteBtn?.addEventListener('click', () => {
        if (audio) {
          audio.pause();
          audio.src = '';
        }
        if (mediaRecorder && mediaRecorder.state === 'recording') {
          mediaRecorder.stop();
          clearInterval(timer);
        }
        audioBlob = null;
        if (audioUrl) {
          URL.revokeObjectURL(audioUrl);
          audioUrl = null;
        }
        duration = 0;
        timerEl.textContent = '00:00';
        recordIcon.textContent = 'mic';
        playIcon.textContent = 'play_arrow';
        playBtn.disabled = true;
        submitBtn.disabled = true;
        recDot.classList.remove('bg-error', 'animate-pulse');
        recDot.classList.add('bg-accent');
        animateBars(false);
        document.getElementById('audio-description').value = '';
        audioSuccess.classList.add('hidden');
        audioError.classList.add('hidden');
      });

      audioForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!audioBlob) {
          audioError.textContent = 'Please record audio before submitting.';
          audioError.classList.remove('hidden');
          return;
        }

        const description = document.getElementById('audio-description').value;
        const formData = new FormData();
        formData.append('audio', audioBlob, `recording_${Date.now()}.webm`);
        if (description) formData.append('description', description);

        try {
          submitBtn.disabled = true;
          document.getElementById('submit-audio-text').textContent = 'Uploading...';

          const API_BASE = import.meta.env.VITE_API_BASE_URL || 'https://crowsys.chrislabs.net/api/v1';
          const res = await fetch(`${API_BASE}/audio/upload`, {
            method: 'POST',
            body: formData,
          });
          const data = await res.json();

          if (data.success) {
            audioSuccess.textContent = '✓ Your audio idea has been submitted successfully. Our team will review it within 4 business hours.';
            audioSuccess.classList.remove('hidden');
            document.getElementById('submit-audio-text').textContent = '✓ Submitted!';
            // Reset after delay
            setTimeout(() => {
              deleteBtn.click();
            }, 3000);
          } else {
            throw new Error(data.message || 'Upload failed');
          }
        } catch (err) {
          audioError.textContent = err.message || 'Network error. Please try again.';
          audioError.classList.remove('hidden');
          submitBtn.disabled = false;
          document.getElementById('submit-audio-text').textContent = 'Submit Audio Idea';
        }
      });
    })();
  </script>
</body>
</html>