---
import { getLocaleData } from "src/locales";
import DefaultLayout from "../components/layout/DefaultLayout.astro";
import ContactForm from "src/components/ContactForm";

const locale = Astro.url.pathname.split("/")[1] === "en" ? "en" : "es";
const data = getLocaleData(locale);

const FORM_FIELDS = data.pages.contact;
---

<DefaultLayout
  title={FORM_FIELDS.title}
  description={FORM_FIELDS.description}
  activeNav={data.nav.contact}
  locale={locale}
>
  <div
    class="pt-32 pb-24 px-6 max-w-7xl mx-auto"
    aria-labelledby="contact-heading"
  >
    <header
      class="flex flex-col md:flex-row gap-8 md:gap-16 items-center mb-16"
    >
      <div class="flex-1">
        <span
          class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block"
          >{FORM_FIELDS.getInTouch}</span
        >
        <h1
          id="contact-heading"
          class="font-heading text-4xl md:text-6xl font-bold text-on-surface tracking-tighter mb-6"
        >
          {FORM_FIELDS.heading}
        </h1>
        <p
          class="text-on-surface-variant max-w-2xl text-lg leading-relaxed font-body"
        >
          {FORM_FIELDS.description2}
        </p>
      </div>
      <div class="flex-1">
        <img
          src="/plane.webp"
          alt=""
          class="rounded-xl w-full h-auto object-cover opacity-70 md:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_35%,black_100%)] md:[mask-image:linear-gradient(to_right,transparent_0%,black_35%,black_100%)]"
        />
      </div>
    </header>

    <div
      class="bg-primary/5 border border-primary/20 rounded-xl p-6 mb-12 flex items-center justify-between gap-4"
    >
      <div class="flex items-center gap-4">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary shrink-0"
        >
          <path d="M9 18h6" />
          <path d="M10 22h4" />
          <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14" />
        </svg>
        <div>
          <p class="font-heading font-bold text-on-surface">
            {FORM_FIELDS.consultingHeading}
          </p>
          <a
            href={data.routes.consulting}
            data-umami-event="consulting-cta"
            data-umami-event-page="contacto"
            class="text-primary font-semibold hover:underline hover:text-primary/80 transition-colors"
          >
            {FORM_FIELDS.consultingLink}
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 space-y-8">
        <div>
          <h3 class="font-heading text-2xl font-bold mb-4 text-on-surface">
            {FORM_FIELDS.startConversation}
          </h3>
          <p class="text-on-surface-variant font-body leading-relaxed">
            {FORM_FIELDS.inquiryDescription}
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-primary mt-1"
              ><rect x="2" y="4" width="20" height="16" rx="2"></rect><path
                d="M22 7l-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"></path></svg
            >
            <div>
              <p class="font-bold text-sm text-on-surface">
                {FORM_FIELDS.inquiries}
              </p>
              <p class="text-sm text-on-surface-variant font-body">
                <a
                  href="mailto:crow.systemsmx@gmail.com"
                  data-umami-event="contact-email-click"
                  class="hover:text-primary transition-colors"
                >crow.systemsmx@gmail.com</a>
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-primary mt-1"
              ><circle cx="12" cy="12" r="10"></circle><polyline
                points="12 6 12 12 16 14"></polyline></svg
            >
            <div>
              <p class="font-bold text-sm text-on-surface">
                {FORM_FIELDS.businessHours}
              </p>
              <p class="text-sm text-on-surface-variant font-body">
                {data.pages.contact.monFri}
              </p>
              <p class="text-sm text-on-surface-variant font-body">
                {data.pages.contact.sat}
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-primary mt-1"
              ><circle cx="12" cy="12" r="10"></circle><path
                d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"></path><circle
                cx="12"
                cy="12"
                r="3"></circle></svg
            >
            <div>
              <p class="font-bold text-sm text-on-surface">
                {FORM_FIELDS.regions}
              </p>
              <p class="text-sm text-on-surface-variant font-body">
                {data.pages.contact.regionsText}
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ContactForm locale={data.pages.contact} client:load />
      </div>
    </div>
  </div>
</DefaultLayout>

