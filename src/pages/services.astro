---
import DefaultLayout from "../components/layout/DefaultLayout.astro";
import en from "../locales/en.json";
import es from "../locales/es.json";

const locale = Astro.url.pathname.split("/")[1] === "es" ? "es" : "en";
const data = locale === "es" ? es : en;

function t(key: string): string {
  const keys = key.split(".");
  let result: any = data;
  for (const k of keys) {
    if (result === undefined || result === null) return key;
    result = result[k];
  }
  return typeof result === "string" ? result : key;
}

const localePrefix = locale === "en" ? "" : `/${locale}`;

const includedLabel = data.pages.services.included;
const idealForLabel = data.pages.services.idealFor;
const techLabel = data.pages.services.technologies;
const getStartedLabel = data.pages.services.getStarted;

const ICONS: Record<string, string> = {
  hub: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z",
  dns: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z",
  terminal: "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM8 15H6v-2h2v2zm0-4H6V9h2v2zm0-4H6V5h2v2zm10 8h-8v-2h8v2zm0-4h-8V9h8v2zm0-4h-8V5h8v2z",
  architecture: "M3 3v18h18V3H3zm16 16H5V5h14v14zM7 9h2v2H7V9zm0 4h2v2H7v-2zm4-4h2v2h-2V9zm0 4h2v2h-2v-2zm4-4h2v2h-2V9zm0 4h2v2h-2v-2z",
  database: "M12 2C8.13 2 5 4.69 5 8c0 3.31 3.13 6 7 6s7-2.69 7-6c0-3.31-3.13-6-7-6zm0 10c-2.76 0-5-1.79-5-4s2.24-4 5-4 5 1.79 5 4-2.24 4-5 4zm0 2c-3.87 0-7-2.69-7-6v4c0 3.31 3.13 6 7 6s7-2.69 7-6v-4c0 3.31-3.13 6-7 6z",
  robot_2: "M22 14h-1v-3c0-1.1-.9-2-2-2h-3V7c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H5c-1.1 0-2 .9-2 2v3H2c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1h1v1c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-1h1c.55 0 1-.45 1-1v-4c0-.55-.45-1-1-1zm-11-7h2v2h-2V7zm-4 4h10v3H7v-3zm-2 7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm14 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z",
};

const serviceKeys = ["systemsConsulting", "itInfrastructure", "softwareSolutions", "technicalStrategy", "digitalTransformation", "automationConsulting"];
const services = serviceKeys.map((key) => data.services[key]);
---

<DefaultLayout
  title={data.pages.services.title}
  description={data.pages.services.description}
  activeNav={data.nav.services}
  locale={locale}
  localePrefix={localePrefix}
>
  <section class="pt-32 pb-20 px-6 max-w-7xl mx-auto" aria-labelledby="services-hero-heading">
    <div class="max-w-3xl">
      <span class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block">{data.pages.services.hero.subtitle}</span>
      <h1 id="services-hero-heading" class="font-heading text-4xl md:text-6xl font-bold tracking-tighter mb-6 text-on-surface leading-tight" set:html={data.pages.services.hero.title}></h1>
      <p class="text-lg text-on-surface-variant leading-relaxed mb-10 max-w-2xl font-body">{data.pages.services.hero.description}</p>
    </div>
  </section>

  <section class="pb-24 px-6 max-w-7xl mx-auto" aria-labelledby="services-heading">
    <h2 id="services-heading" class="sr-only">Our Services</h2>
    <div id="services-grid" class="grid grid-cols-1 gap-8">
      {services.map((service) => (
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm hover:border-primary/50 transition-all duration-300 hover:shadow-md" aria-label={service.title}>
          <div class="p-8 flex flex-col">
            <h3 class="font-heading text-2xl font-bold text-on-surface mb-4">{service.title}</h3>
            <p class="text-on-surface-variant font-body leading-relaxed text-sm mb-6">{service.fullDescription}</p>
            <div class="space-y-5">
              <div>
                <h4 class="font-heading text-sm font-bold text-on-surface mb-3 uppercase tracking-wider">{includedLabel}</h4>
                <ul class="space-y-2">
                  {service.features.map((f: string) => (
                    <li class="flex items-start gap-3 text-sm text-on-surface-variant font-body">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent mt-0.5 shrink-0"><path d="M20 6L9 17l-5-5"></path></svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="font-heading text-sm font-bold text-on-surface mb-2 uppercase tracking-wider">{idealForLabel}</h4>
                <p class="text-sm text-on-surface-variant font-body leading-relaxed">{service.idealFor}</p>
              </div>
              <div>
                <h4 class="font-heading text-sm font-bold text-on-surface mb-2 uppercase tracking-wider">{techLabel}</h4>
                <div class="flex flex-wrap gap-2 mt-1">
                  {service.technologies.map((t: string) => (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent border border-accent/20">{t}</span>
                  ))}
                </div>
              </div>
              <div class="pt-4 border-t border-outline-variant/30 mt-4">
                <a href={data.routes.consulting} class="inline-flex items-center gap-2 text-primary font-bold text-sm hover:text-accent transition-colors group">
                  {getStartedLabel}{service.title}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform"><path d="M22 2L11 13"></path><path d="M22 2L15 22L11 13L2 9L22 2Z"></path></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="pb-24 px-6 max-w-7xl mx-auto" aria-labelledby="process-heading">
    <h2 id="process-heading" class="font-heading text-3xl font-bold text-on-surface text-center mb-12">{t("pages.services.process.title")}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {[0,1,2].map((i) => {
        const title = data.pages.services.process.steps[i].title;
        const desc = data.pages.services.process.steps[i].description;
        return <div class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/30 text-center hover:border-primary/50 transition-all hover:shadow-md">
          <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-6"><span class="font-heading text-xl font-bold text-primary">{String(i+1).padStart(2,"0")}</span></div>
          <h4 class="font-heading text-lg font-bold text-on-surface mb-3">{title}</h4>
          <p class="text-on-surface-variant text-sm font-body leading-relaxed">{desc}</p>
        </div>;
      })}
    </div>
  </section>

  <section class="mx-6 md:mx-8 mb-20 relative overflow-hidden bg-primary rounded-xl p-12 md:p-20">
    <div class="relative z-10 max-w-2xl">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4" set:html={data.pages.services.cta.title}></h2>
      <p class="text-white text-lg mb-8 font-body">{data.pages.services.cta.description}</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href={data.routes.consulting} class="border border-white text-white px-8 py-4 rounded-xl hover:bg-on-primary/10 transition-all text-center text-sm font-bold">{data.pages.services.cta.startConsultation}</a>
      </div>
    </div>
  </section>
</DefaultLayout>

<script type="module" src="../scripts/site.js"></script>
