---
import DefaultLayout from "../components/layout/DefaultLayout.astro";
---

<DefaultLayout
  title="Contact — CROW SYSTEMS"
  description="Contact Crow Systems for technology consulting, systems audits, and strategic partnerships."
  activeNav="Contact"
>
  <div
    class="pt-32 pb-24 px-6 max-w-7xl mx-auto"
    aria-labelledby="contact-heading"
  >
    <header class="mb-16">
      <span
        class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block"
        >Get In Touch</span
      >
      <h1
        id="contact-heading"
        class="font-heading text-4xl md:text-6xl font-bold text-on-surface tracking-tighter mb-6"
      >
        Contact Us
      </h1>
      <p
        class="text-on-surface-variant max-w-2xl text-lg leading-relaxed font-body"
      >
        Whether you need a full systems audit, a strategic consultation, or an
        engineering partner for your next project, our team is ready to help.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 space-y-8">
        <div>
          <h3 class="font-heading text-2xl font-bold mb-4 text-on-surface">
            Start a Conversation
          </h3>
          <p class="text-on-surface-variant font-body leading-relaxed">
            Have a technical challenge or project idea? We'd like to hear about
            it. Our engineers will review your inquiry and respond within 4
            business hours.
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              class="text-primary mt-1"
              ><rect x="2" y="4" width="20" height="16" rx="2"></rect><path
                d="M22 7l-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"></path></svg
            >
            <div>
              <p class="font-bold text-sm text-on-surface">Inquiries</p>
              <p class="text-sm text-on-surface-variant font-body">
                solutions@crowsystems.tech
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              class="text-primary mt-1"
              ><circle cx="12" cy="12" r="10"></circle><polyline
                points="12 6 12 12 16 14"></polyline></svg
            >
            <div>
              <p class="font-bold text-sm text-on-surface">Business Hours</p>
              <p class="text-sm text-on-surface-variant font-body">
                Mon — Fri: 08:00 - 18:00 EST
              </p>
              <p class="text-sm text-on-surface-variant font-body">
                Sat: 10:00 - 14:00 EST (On-call only)
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              class="text-primary mt-1"
              ><circle cx="12" cy="12" r="10"></circle><line
                x1="2"
                y1="12"
                x2="22"
                y2="12"></line><path
                d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"
              ></path></svg
            >
            <div>
              <p class="font-bold text-sm text-on-surface">Regions Served</p>
              <p class="text-sm text-on-surface-variant font-body">
                North America, European Union, &amp; APAC
              </p>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-outline-variant/50 flex gap-6">
          <a
            href="https://www.linkedin.com/company/crowsystems"
            class="text-sm text-on-surface-variant hover:text-primary transition-colors font-medium"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <a
            href="https://www.x.com/@crowsystems"
            class="text-sm text-on-surface-variant hover:text-primary transition-colors font-medium"
            target="_blank"
            rel="noopener noreferrer">Twitter</a
          >
          <a
            href="https://www.instagram.com/@crowsystems"
            class="text-sm text-on-surface-variant hover:text-primary transition-colors font-medium"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
        </div>
      </div>

      <div class="lg:col-span-7">
        <div
          id="contact-error"
          class="hidden mb-6 p-4 bg-red-50 text-red-600 rounded-lg text-sm font-medium"
          role="alert"
        >
        </div>
        <div
          id="contact-success"
          class="hidden mb-6 p-4 bg-green-50 text-green-700 rounded-lg text-sm font-medium"
          role="status"
        >
        </div>
        <form
          id="contact-form"
          class="bg-surface-container-lowest p-8 md:p-12 rounded-xl border border-outline-variant/30 shadow-sm space-y-6"
          novalidate
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label
                for="cnt-name"
                class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
                >Name <span class="text-error">*</span></label
              >
              <input
                id="cnt-name"
                type="text"
                placeholder="John Doe"
                required
                class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all"
              />
              <p class="hidden text-sm text-red-500 mt-1" id="cnt-name-err">
                Name is required
              </p>
            </div>
            <div class="space-y-2">
              <label
                for="cnt-email"
                class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
                >Email <span class="text-error">*</span></label
              >
              <input
                id="cnt-email"
                type="email"
                placeholder="john@enterprise.com"
                required
                class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all"
              />
              <p class="hidden text-sm text-red-500 mt-1" id="cnt-email-err">
                Valid email required
              </p>
            </div>
          </div>
          <div class="space-y-2">
            <label
              for="cnt-subject"
              class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
              >Subject <span class="text-error">*</span></label
            >
            <input
              id="cnt-subject"
              type="text"
              placeholder="How can we help?"
              required
              class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all"
            />
            <p class="hidden text-sm text-red-500 mt-1" id="cnt-subject-err">
              Subject is required
            </p>
          </div>
          <div class="space-y-2">
            <label
              for="cnt-message"
              class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
              >Message <span class="text-error">*</span></label
            >
            <textarea
              id="cnt-message"
              rows="5"
              placeholder="Tell us about your project or challenge..."
              required
              class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all resize-none font-body text-sm"
            ></textarea>
            <p class="hidden text-sm text-red-500 mt-1" id="cnt-message-err">
              Message is required (min 10 characters)
            </p>
          </div>
          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full bg-primary text-white font-bold py-5 rounded-xl hover:bg-primary/90 active:scale-[0.98] transition-all shadow-lg shadow-primary/20"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener("click", (e) => {
        const target = document.querySelector(a.getAttribute("href"));
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth" });
        }
      });
    });

    document
      .getElementById("contact-form")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        let valid = true;
        const name = document.getElementById("cnt-name").value;
        const email = document.getElementById("cnt-email").value;
        const subject = document.getElementById("cnt-subject").value;
        const message = document.getElementById("cnt-message").value;

        ["name", "email", "subject", "message"].forEach((id) =>
          document
            .getElementById("cnt-" + id + "-err")
            ?.classList.add("hidden"),
        );
        document.getElementById("contact-error")?.classList.add("hidden");

        if (!name.trim()) {
          document.getElementById("cnt-name-err").classList.remove("hidden");
          valid = false;
        }
        if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {
          document.getElementById("cnt-email-err").classList.remove("hidden");
          valid = false;
        }
        if (!subject.trim()) {
          document.getElementById("cnt-subject-err").classList.remove("hidden");
          valid = false;
        }
        if (message.trim().length < 10) {
          document.getElementById("cnt-message-err").classList.remove("hidden");
          valid = false;
        }
        if (!valid) return;

        try {
          document.getElementById("contact-submit-btn").disabled = true;
          document.getElementById("contact-submit-btn").textContent =
            "Sending...";
          const base =
            import.meta.env.VITE_API_BASE_URL ||
            "https://crowsys.chrislabs.net/api/v1";
          const res = await fetch(`${base}/contact`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: name.trim(),
              email: email.trim(),
              subject: subject.trim(),
              message: message.trim(),
            }),
          });
          const result = await res.json();
          if (result.success) {
            document.getElementById("contact-success").textContent =
              "Thank you! Your message has been sent. We will get back to you soon.";
            document
              .getElementById("contact-success")
              .classList.remove("hidden");
            document.getElementById("contact-form").reset();
          } else {
            throw new Error(result.message);
          }
        } catch (err) {
          document.getElementById("contact-error").textContent =
            err.message || "Submission failed. Please try again.";
          document.getElementById("contact-error").classList.remove("hidden");
        } finally {
          document.getElementById("contact-submit-btn").disabled = false;
          document.getElementById("contact-submit-btn").textContent =
            "Send Message";
        }
      });
  </script>
</DefaultLayout>
