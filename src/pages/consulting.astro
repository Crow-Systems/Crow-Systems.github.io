<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Submit a consulting request to Crow Systems. Get a technical audit, strategic consultation, or roadmap for your business." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://crowsys.chrislabs.net/consulting" />
  <meta property="og:title" content="Consulting — CROW SYSTEMS" />
  <meta property="og:description" content="Submit a consulting request to Crow Systems. Get a technical audit, strategic consultation, or roadmap for your business." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://crowsys.chrislabs.net/consulting" />
  <title>Consulting — CROW SYSTEMS</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-background text-on-surface selection:bg-primary/20 font-body grid-bg min-h-screen">

  <nav class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-md border-b border-outline-variant/30" role="navigation" aria-label="Main navigation">
    <div class="flex justify-between items-center w-full px-6 md:px-8 py-4 max-w-7xl mx-auto">
      <a href="/" class="font-heading text-xl font-black tracking-tighter text-primary">CROW SYSTEMS</a>
      <div class="hidden md:flex items-center gap-6">
        <a href="/#services" class="text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm">Services</a>
        <a href="/#ideas" class="text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm">Ideas</a>
        <a href="/consulting" class="text-primary font-bold border-b-2 border-primary pb-1 text-sm">Consulting</a>
        <a href="/about" class="text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm">About</a>
        <a href="/#contact" class="text-on-surface-variant hover:text-primary font-medium transition-colors duration-300 text-sm">Contact</a>
      </div>
      <a href="#consulting" class="bg-primary text-on-primary font-bold px-5 py-2 rounded-lg text-sm hover:bg-primary/90 transition-all active:scale-95 shadow-sm">Get Started</a>
      <button class="md:hidden p-2 text-on-surface" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </nav>

  <main class="pt-32 pb-24 px-6 max-w-7xl mx-auto">
    <header aria-labelledby="consulting-heading">
      <span class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block">Consultation Portal</span>
      <h1 id="consulting-heading" class="font-heading text-4xl md:text-6xl font-bold text-on-surface tracking-tighter mb-6">
        Articulate Your Vision.<br/><span class="text-surface-variant">We Engineer the Rest.</span>
      </h1>
      <p class="text-on-surface-variant max-w-2xl text-lg leading-relaxed font-body mb-16">
        Provide the foundations of your business challenge. Use our high-fidelity audio capture to explain complex nuances, or detail your requirements through our structured technical brief.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Audio Submission -->
      <section aria-labelledby="audio-heading">
        <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-2xl p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-8">
            <div class="w-3 h-3 bg-error rounded-full" id="rec-dot2"></div>
            <h2 id="audio-heading" class="font-heading text-2xl font-bold text-on-surface">Audio Idea Submission</h2>
          </div>
          <div class="bg-surface rounded-xl p-10 border border-outline-variant/30 mb-8 flex flex-col items-center justify-center text-center">
            <div class="flex gap-2 items-center mb-8 h-16" id="audio-bars2">
              {[1,2,3,4,5,6,7].map(i => (
                <div key={i} class="w-1 rounded-full bg-outline-variant/40" style={`height:${8+i*3}px`}></div>
              ))}
            </div>
            <div class="flex items-center gap-6">
              <button id="delete-rec2" class="w-12 h-12 rounded-full border border-outline-variant/50 flex items-center justify-center text-on-surface-variant disabled:opacity-30" disabled aria-label="Delete recording">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" /></svg>
              </button>
              <button id="record-btn2" class="w-20 h-20 rounded-full bg-error text-white flex items-center justify-center shadow-lg shadow-error/30 active:scale-95 transition-all" aria-label="Start recording">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" id="record-icon2"><path d="M12 2a3 3 0 00-3 3v7a3 3 0 006 0V5a3 3 0 00-3-3z" /><path d="M19 10a1 1 0 012 0 7 7 0 01-2.516 5.482 1 1 0 01-1.464-1.464A5 5 0 0019 10z" /><path d="M5 10a1 1 0 01-2 0 7 7 0 012.516-5.482 1 1 0 011.464 1.464A5 5 0 005 10z" /><path d="M12 18a2 2 0 002-2v-1a2 2 0 00-4 0v1a2 2 0 002 2z" /></svg>
              </button>
              <button id="play-btn2" class="w-12 h-12 rounded-full border border-outline-variant/50 flex items-center justify-center text-on-surface-variant disabled:opacity-30" disabled aria-label="Play recording">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" id="play-icon2"><path d="M8 5v14l11-7z" /></svg>
              </button>
            </div>
            <p class="mt-6 font-mono text-sm text-on-surface-variant">
              <span id="timer2">00:00</span> / 05:00
            </p>
          </div>
          <div class="space-y-4">
            <label class="block text-sm font-bold uppercase tracking-widest text-on-surface-variant">Additional Context <span class="text-on-surface-variant/60">(Optional)</span></label>
            <textarea id="audio-description2" class="w-full bg-white border border-outline-variant rounded-lg p-4 text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none min-h-[100px] transition-all font-body text-sm" placeholder="Describe any technical constraints or specific outcomes..."></textarea>
          </div>
          <div id="audio-error2" class="hidden mt-4 text-sm text-red-600 bg-red-50 p-3 rounded-lg" role="alert"></div>
          <div id="audio-success2" class="hidden mt-4 text-sm text-green-700 bg-green-50 p-3 rounded-lg font-medium" role="status"></div>
          <button id="submit-audio2" class="w-full mt-6 bg-primary text-on-primary font-bold py-4 rounded-xl flex items-center justify-center gap-2 transition-all hover:bg-primary/90 shadow-lg shadow-primary/20 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
            <span id="submit-audio-text2">Submit Audio Idea</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13" /><path d="M22 2L15 22L11 13L2 9L22 2Z" /></svg>
          </button>
        </div>
      </section>

      <!-- Consulting Form -->
      <section aria-labelledby="consult-form-heading">
        <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-2xl p-8 shadow-sm">
          <h3 id="consult-form-heading" class="font-heading text-xl font-bold mb-6 text-on-surface">Consulting Request Form</h3>
          <div id="consult-error" class="hidden mb-6 p-4 bg-red-50 text-red-600 rounded-lg text-sm font-medium" role="alert"></div>
          <div id="consult-success" class="hidden mb-6 p-4 bg-green-50 text-green-700 rounded-lg text-sm font-medium font-bold" role="status"></div>
          <form id="consult-form" class="space-y-6" novalidate>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="c-fullname" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Full Name <span class="text-error">*</span></label>
                <input id="c-fullname" type="text" placeholder="John Doe" required class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" />
                <p class="hidden text-sm text-error mt-1" id="c-fullname-err">Name must be at least 2 characters</p>
              </div>
              <div class="space-y-2">
                <label for="c-company" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Company <span class="text-error">*</span></label>
                <input id="c-company" type="text" placeholder="Acme Corp" required class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" />
                <p class="hidden text-sm text-error mt-1" id="c-company-err">Company name is required</p>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="c-email" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Work Email <span class="text-error">*</span></label>
                <input id="c-email" type="email" placeholder="j.doe@acme.com" required class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" />
                <p class="hidden text-sm text-error mt-1" id="c-email-err">Please enter a valid email</p>
              </div>
              <div class="space-y-2">
                <label for="c-phone" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Phone</label>
                <input id="c-phone" type="tel" placeholder="+1 (555) 000-0000" class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" />
              </div>
            </div>
            <div class="space-y-2">
              <label for="c-problem" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Business Problem <span class="text-error">*</span></label>
              <select id="c-problem" required class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all appearance-none cursor-pointer">
                <option value="">Select a business problem</option>
                <option>Operational Inefficiency</option>
                <option>Digital Transformation</option>
                <option>Market Entry Strategy</option>
                <option>Technical Debt Reduction</option>
                <option>Infrastructure Scaling</option>
                <option>Other</option>
              </select>
              <p class="hidden text-sm text-error mt-1" id="c-problem-err">Please select a business problem</p>
            </div>
            <div class="space-y-2">
              <label for="c-goals" class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Project Goals</label>
              <textarea id="c-goals" rows="3" placeholder="What do you hope to achieve?" class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all resize-none font-body text-sm"></textarea>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold uppercase tracking-widest text-on-surface-variant">Budget Range</label>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <button type="button" class="budget-btn px-4 py-2 border border-outline-variant rounded-lg text-sm hover:bg-surface/50 hover:border-primary transition-all text-on-surface">$10k - $25k</button>
                <button type="button" class="budget-btn px-4 py-2 border border-primary bg-primary/10 text-primary rounded-lg text-sm font-bold">$25k - $50k</button>
                <button type="button" class="budget-btn px-4 py-2 border border-outline-variant rounded-lg text-sm hover:bg-surface/50 hover:border-primary transition-all text-on-surface">$50k - $100k</button>
                <button type="button" class="budget-btn px-4 py-2 border border-outline-variant rounded-lg text-sm hover:bg-surface/50 hover:border-primary transition-all text-on-surface">$100k+</button>
              </div>
              <input type="hidden" id="c-budget" value="$25k-$50k" />
            </div>
            <button type="submit" id="consult-submit-btn" class="w-full bg-primary text-on-primary font-bold py-5 rounded-xl flex items-center justify-center gap-2 transition-all hover:bg-primary/90 shadow-lg shadow-primary/20">
              <span id="consult-btn-text">Submit Consulting Request</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13" /><path d="M22 2L15 22L11 13L2 9L22 2Z" /></svg>
            </button>
          </form>
        </div>

        <!-- Engagement Method & Quote -->
        <div class="space-y-6 mt-12">
          <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-8 shadow-sm">
            <h4 class="font-heading text-lg font-bold mb-6 text-on-surface">The Crow Engagement Method</h4>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container shrink-0 font-bold text-sm">01</div>
                <div>
                  <p class="text-on-surface font-bold text-sm">Triage</p>
                  <p class="text-on-surface-variant text-sm mt-1 font-body">Our lead architects review your submission within 4 business hours.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container shrink-0 font-bold text-sm">02</div>
                <div>
                  <p class="text-on-surface font-bold text-sm">Discovery</p>
                  <p class="text-on-surface-variant text-sm mt-1 font-body">A 30-minute high-fidelity call to align on technical constraints and KPI targets.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container shrink-0 font-bold text-sm">03</div>
                <div>
                  <p class="text-on-surface font-bold text-sm">Proposal</p>
                  <p class="text-on-surface-variant text-sm mt-1 font-body">A comprehensive roadmap with fixed-fee options delivered in 48 hours.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white border border-outline-variant/30 rounded-xl p-8 shadow-sm">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-primary/20">
                <img alt="Marcus Thorne" class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=200&q=80" />
              </div>
              <div>
                <p class="font-bold text-on-surface">Marcus Thorne</p>
                <p class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold">Managing Partner, Crow Systems</p>
              </div>
            </div>
            <p class="italic text-on-surface-variant text-sm leading-relaxed border-l-2 border-primary/30 pl-4">&ldquo;We built this intake system to capture the 'why' behind the problem. Audio allows us to hear the priorities that spreadsheets often hide.&rdquo;</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="bg-surface-container-lowest border-t border-outline-variant/20" role="contentinfo">
    <div class="flex flex-col md:flex-row justify-between items-center w-full px-6 md:px-8 py-10 max-w-7xl mx-auto gap-6">
      <div class="flex flex-col gap-2">
        <span class="font-heading text-base font-bold text-primary">CROW SYSTEMS</span>
        <p class="font-body text-sm text-on-surface-variant">&copy; 2024 Crow Systems. Precision-Engineered Consulting.</p>
      </div>
      <div class="flex gap-6 flex-wrap justify-center">
        <a href="#" class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors">LinkedIn</a>
        <a href="#" class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors">Twitter</a>
        <a href="#privacy" class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors">Privacy Policy</a>
        <a href="#terms" class="font-body text-sm text-on-surface-variant hover:text-primary transition-colors">Terms of Service</a>
      </div>
    </div>
  </footer>

  <script>
    (() => {
      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', (e) => {
          const target = document.querySelector(a.getAttribute('href'));
          if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
        });
      });

      // --- Audio Recording Controller ---
      let mediaRecorder = null, chunks = [], audioBlob = null, audioUrl = null, timer = null, duration = 0, audio = null;
      const recordBtn = document.getElementById('record-btn2');
      const recordIcon = document.getElementById('record-icon2');
      const playBtn = document.getElementById('play-btn2');
      const playIcon = document.getElementById('play-icon2');
      const deleteBtn = document.getElementById('delete-rec2');
      const timerEl = document.getElementById('timer2');
      const errorEl = document.getElementById('audio-error2');
      const successEl = document.getElementById('audio-success2');
      const submitBtn = document.getElementById('submit-audio2');
      const submitText = document.getElementById('submit-audio-text2');
      const recDot = document.getElementById('rec-dot2');
      const bars = document.getElementById('audio-bars2');

      const fmt = s => `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`;
      const animBars = on => {
        [...bars.children].forEach(b => {
          if (on) { b.classList.add('bg-primary','animate-pulse'); b.classList.remove('bg-outline-variant/40'); }
          else { b.classList.remove('bg-primary','animate-pulse'); b.classList.add('bg-outline-variant/40'); }
        });
      };

      recordBtn?.addEventListener('click', async () => {
        if (mediaRecorder?.state === 'recording') { mediaRecorder.stop(); clearInterval(timer); recordIcon.textContent='mic'; recDot.classList.replace('bg-error','bg-accent'); recDot.classList.remove('animate-pulse'); animBars(false); playBtn.disabled=false; return; }
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          const mt = ['audio/webm','audio/mp3','audio/wav','audio/ogg'].find(t => MediaRecorder.isTypeSupported(t)) || 'audio/webm';
          mediaRecorder = new MediaRecorder(stream, { mimeType: mt });
          chunks = []; duration = 0;
          mediaRecorder.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
          mediaRecorder.onstop = () => { audioBlob = new Blob(chunks, {type: mt}); if (audioUrl) URL.revokeObjectURL(audioUrl); audioUrl = URL.createObjectURL(audioBlob); stream.getTracks().forEach(t=>t.stop()); submitBtn.disabled=false; };
          mediaRecorder.start();
          recordIcon.textContent = 'stop'; recDot.classList.replace('bg-accent','bg-error'); recDot.classList.add('animate-pulse'); playBtn.disabled=true; animBars(true);
          timer = setInterval(() => { duration++; timerEl.textContent = fmt(duration); if (duration >= 300) { mediaRecorder.stop(); clearInterval(timer); recordIcon.textContent='mic'; recDot.classList.replace('bg-error','bg-accent'); recDot.classList.remove('animate-pulse'); animBars(false); playBtn.disabled=false; } }, 1000);
        } catch { errorEl.textContent='Microphone access denied.'; errorEl.classList.remove('hidden'); recordBtn.disabled=true; }
      });

      playBtn?.addEventListener('click', () => { if (!audioUrl) return; if (!audio) { audio=new Audio(); audio.onended=()=>playIcon.textContent='play_arrow'; } audio.src=audioUrl; audio.play(); playIcon.textContent='pause'; });

      deleteBtn?.addEventListener('click', () => {
        if (audio) { audio.pause(); audio.src=''; }
        if (mediaRecorder?.state==='recording') { mediaRecorder.stop(); clearInterval(timer); }
        audioBlob=null; if(audioUrl){URL.revokeObjectURL(audioUrl);audioUrl=null;} duration=0; timerEl.textContent='00:00'; recordIcon.textContent='mic'; playIcon.textContent='play_arrow'; playBtn.disabled=true;submitBtn.disabled=true; recDot.classList.replace('bg-error','bg-accent'); recDot.classList.remove('animate-pulse'); animBars(false);
      });

      submitBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!audioBlob) { errorEl.textContent='Please record audio first.'; errorEl.classList.remove('hidden'); return; }
        const desc = document.getElementById('audio-description2').value;
        const fd = new FormData(); fd.append('audio', audioBlob, `rec_${Date.now()}.webm`);
        if (desc) fd.append('description', desc);
        try {
          submitBtn.disabled=true; submitText.textContent='Uploading...';
          const base = import.meta.env.VITE_API_BASE_URL || 'https://crowsys.chrislabs.net/api/v1';
          const res = await fetch(`${base}/audio/upload`, { method:'POST', body: fd });
          const data = await res.json();
          if (data.success) { successEl.textContent='✓ Audio submitted! We will review it within 4 business hours.'; successEl.classList.remove('hidden'); submitText.textContent='✓ Submitted!'; setTimeout(()=>deleteBtn.click(),3000); }
          else throw new Error(data.message||'Upload failed');
        } catch (err) { errorEl.textContent=err.message||'Network error.'; errorEl.classList.remove('hidden'); submitBtn.disabled=false; submitText.textContent='Submit Audio Idea'; }
      });

      // --- Consulting Form Controller ---
      const budgetBtns = document.querySelectorAll('.budget-btn');
      budgetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          budgetBtns.forEach(b => { b.classList.remove('border-primary','bg-primary/10','text-primary','font-bold'); b.classList.add('border-outline-variant','text-on-surface','hover:bg-surface/50','hover:border-primary'); });
          btn.classList.remove('border-outline-variant','text-on-surface','hover:bg-surface/50','hover:border-primary');
          btn.classList.add('border-primary','bg-primary/10','text-primary','font-bold');
          document.getElementById('c-budget').value = btn.textContent.trim();
        });
      });

      document.getElementById('consult-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        let valid = true;
        const name = document.getElementById('c-fullname').value.trim();
        const company = document.getElementById('c-company').value.trim();
        const email = document.getElementById('c-email').value.trim();
        const problem = document.getElementById('c-problem').value;

        ['c-fullname','c-company','c-email','c-problem'].forEach(id => document.getElementById(id+'-err')?.classList.add('hidden'));
        document.getElementById('consult-error')?.classList.add('hidden');

        if (name.length < 2) { document.getElementById('c-fullname-err')?.classList.remove('hidden'); valid=false; }
        if (!company) { document.getElementById('c-company-err')?.classList.remove('hidden'); valid=false; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { document.getElementById('c-email-err')?.classList.remove('hidden'); valid=false; }
        if (!problem) { document.getElementById('c-problem-err')?.classList.remove('hidden'); valid=false; }
        if (!valid) return;

        const data = { fullName: name, company, email, phone: document.getElementById('c-phone').value.trim(), businessProblem: problem, projectGoals: document.getElementById('c-goals').value.trim(), budgetRange: document.getElementById('c-budget').value };

        try {
          document.getElementById('consult-btn-text').textContent = 'Submitting...';
          document.getElementById('consult-submit-btn').disabled = true;
          const base = import.meta.env.VITE_API_BASE_URL || 'https://crowsys.chrislabs.net/api/v1';
          const res = await fetch(`${base}/consultation`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
          const result = await res.json();
          if (result.success) {
            document.getElementById('consult-success').textContent = 'Thank you! Your consultation request has been submitted. We will be in touch within 4 business hours.';
            document.getElementById('consult-success').classList.remove('hidden');
            document.getElementById('consult-form').reset();
            budgetBtns.forEach(b => { b.classList.remove('border-primary','bg-primary/10','text-primary','font-bold'); b.classList.add('border-outline-variant','text-on-surface','hover:bg-surface/50','hover:border-primary'); });
            budgetBtns[1].classList.add('border-primary','bg-primary/10','text-primary','font-bold');
          } else { throw new Error(result.message); }
        } catch (err) {
          document.getElementById('consult-error').textContent = err.message || 'Submission failed. Please try again.';
          document.getElementById('consult-error').classList.remove('hidden');
        } finally {
          document.getElementById('consult-btn-text').textContent = 'Submit Consulting Request';
          document.getElementById('consult-submit-btn').disabled = false;
        }
      });
    })();
  </script>
</body>
</html>