---
import DefaultLayout from "../components/layout/DefaultLayout.astro";
import en from "../locales/en.json";
import es from "../locales/es.json";

const locale = Astro.url.pathname.split("/")[1] === "es" ? "es" : "en";
const data = locale === "es" ? es : en;

function t(key: string): string {
  const keys = key.split(".");
  let result: any = data;
  for (const k of keys) {
    if (result === undefined || result === null) return key;
    result = result[k];
  }
  return typeof result === "string" ? result : key;
}

const sections = data.pages.privacy.sections;
---

<DefaultLayout
  title={t("pages.privacy.title")}
  description={t("pages.privacy.description")}
  activeNav={t("nav.contact")}
  locale={locale}
>
  <div class="pt-32 pb-24 px-6 max-w-4xl mx-auto">
    <header class="mb-12">
      <span class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block">Legal</span>
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-on-surface tracking-tight mb-4">
        {t("pages.privacy.heading")}
      </h1>
      <p class="text-on-surface-variant text-lg leading-relaxed font-body">
        {t("pages.privacy.intro")}
      </p>
    </header>

    <div class="space-y-10">
      {sections.map((section) => (
        <section>
          <h2 class="font-heading text-2xl font-bold text-on-surface mb-4">{section.title}</h2>
          {"items" in section ? (
            <>
              <p class="text-on-surface-variant/80 leading-relaxed font-body text-sm mb-4">{section.intro}</p>
              <ul class="space-y-2 text-on-surface-variant/80 font-body text-sm list-disc pl-6 mb-4">
                {section.items?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {section.extra && <p class="text-on-surface-variant/80 leading-relaxed font-body text-sm">{section.extra}</p>}
            </>
          ) : (
            <p class="text-on-surface-variant/80 leading-relaxed font-body text-sm">{section.content}</p>
          )}
        </section>
      ))}
    </div>
  </div>
</DefaultLayout>