---
import DefaultLayout from '../components/layout/DefaultLayout.astro';
---

<DefaultLayout title="404 — CROW SYSTEMS">
  <div class="flex-1 flex items-center justify-center pt-28 px-6">
    <div class="text-center max-w-2xl mx-auto">
      <p class="font-heading text-8xl font-bold text-primary/20 mb-4">404</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-on-surface mb-4">Page Not Found</h1>
      <p class="text-on-surface-variant text-lg font-body mb-8">
        The page you are looking for does not exist or has been moved.
      </p>
      <a href="/" class="bg-primary text-on-primary font-bold px-8 py-4 rounded-xl hover:bg-primary/90 transition-all active:scale-[0.98] shadow-lg shadow-primary/20 inline-block">
        Return to Home
      </a>
    </div>
</DefaultLayout>