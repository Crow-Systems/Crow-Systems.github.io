---
import { getLocaleData } from "src/locales";
import DefaultLayout from "../../components/layout/DefaultLayout.astro";
import FlyerContent from "../../components/flyer/CorporateFlyerContent.astro";

const locale = "en";
const data = getLocaleData(locale);
const origin = Astro.site?.origin || "https://crowsys.chrislabs.net";
const qrUrl = `${origin}${data.routes.consulting}`;
---

<DefaultLayout
  title={data.pages.flyer.title}
  description={data.pages.flyer.description}
  activeNav=""
  locale={locale}
>
  <FlyerContent
    content={data.pages.flyer.content}
    origin={origin}
    qrUrl={qrUrl}
    downloadLabel={data.pages.flyer.downloadLabel}
  />
</DefaultLayout>
