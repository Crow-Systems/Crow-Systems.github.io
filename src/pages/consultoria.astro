---
import { getLocaleData } from "src/locales";
import DefaultLayout from "../components/layout/DefaultLayout.astro";

const locale = Astro.url.pathname.split("/")[1] === "en" ? "en" : "es";
const data = getLocaleData(locale);

const DATA_JSON = JSON.stringify(data);
void DATA_JSON;
---

<DefaultLayout
  title={data.pages.consulting.title}
  description={data.pages.consulting.description}
  activeNav={data.nav.consulting}
  locale={locale}
>
  <div
    class="pt-32 pb-24 px-6 max-w-7xl mx-auto"
    aria-labelledby="consulting-heading"
  >
    <header
      aria-labelledby="consulting-heading"
      class="flex flex-col md:flex-row gap-8 md:gap-16 items-center mb-16"
    >
      <div class="flex-1">
        <span
          class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block"
          >{data.pages.consulting.portal}</span
        >
        <h1
          id="consulting-heading"
          class="font-heading text-4xl md:text-6xl font-bold text-on-surface tracking-tighter mb-6"
          set:html={data.pages.consulting.heading}
        />
        <p
          class="text-on-surface-variant max-w-2xl text-lg leading-relaxed font-body"
        >
          {data.pages.consulting.description2}
        </p>
      </div>
      <div class="flex-1">
        <img
          src="/clarity.webp"
          alt=""
          class="rounded-xl w-full h-auto object-cover md:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_35%,black_100%)] md:[mask-image:linear-gradient(to_right,transparent_0%,black_35%,black_100%)]"
        />
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <section aria-labelledby="audio-heading">
        <div
          class="bg-surface-container-lowest border border-outline-variant/50 rounded-2xl p-8 shadow-sm"
        >
          <div class="flex items-center gap-3 mb-8">
            <div class="w-3 h-3 bg-red-500 rounded-full" id="rec-dot"></div>
            <h2
              id="audio-heading"
              class="font-heading text-2xl font-bold text-on-surface"
            >
              {data.pages.consulting.audioSubmission}
            </h2>
          </div>
          <div
            class="bg-surface rounded-xl p-10 border border-outline-variant/30 mb-8 flex flex-col items-center justify-center text-center"
          >
            <div class="flex gap-1 items-center mb-8 h-16">
              <div
                class="w-1 rounded-full bg-outline-variant/40"
                style="height:11px"
              >
              </div>
              <div
                class="w-1 rounded-full bg-outline-variant/60"
                style="height:14px"
              >
              </div>
              <div
                class="w-1 rounded-full bg-outline-variant/60"
                style="height:17px"
              >
              </div>
              <div class="w-1 rounded-full bg-primary/60" style="height:20px">
              </div>
              <div class="w-1 rounded-full bg-primary" style="height:23px">
              </div>
              <div class="w-1 rounded-full bg-primary/60" style="height:20px">
              </div>
              <div
                class="w-1 rounded-full bg-outline-variant/60"
                style="height:17px"
              >
              </div>
              <div
                class="w-1 rounded-full bg-outline-variant/40"
                style="height:14px"
              >
              </div>
              <div
                class="w-1 rounded-full bg-outline-variant/40"
                style="height:11px"
              >
              </div>
            </div>
            <div class="flex items-center gap-6">
              <button
                id="delete-rec"
                class="w-12 h-12 rounded-full border border-outline-variant/50 flex items-center justify-center text-on-surface-variant hover:border-red-500 hover:text-red-500 transition-all disabled:opacity-30"
                disabled
                aria-label={data.pages.consulting.recordDeleteLabel}
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><polyline points="3 6 5 6 21 6"></polyline><path
                    d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"></path><path
                    d="M10 11v6"></path><path d="M14 11v6"></path><path
                    d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"></path></svg
                >
              </button>
              <button
                id="record-btn"
                class="w-20 h-20 rounded-full text-4xl bg-primary text-white flex items-center justify-center shadow-lg shadow-primary/20 active:scale-95 transition-all"
                aria-label={data.pages.consulting.recordStartLabel}
              >
                🎙️
              </button>
              <button
                id="play-btn"
                class="w-12 h-12 rounded-full border border-outline-variant/50 flex items-center justify-center text-on-surface-variant hover:border-primary hover:text-primary transition-all disabled:opacity-30"
                disabled
                aria-label={data.pages.consulting.playLabel}
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  id="play-icon"><path d="M8 5v14l11-7z"></path></svg
                >
              </button>
            </div>
            <p class="mt-6 font-mono text-sm text-on-surface-variant">
              <span id="timer">00:00</span> / 05:00
            </p>
          </div>
          <div class="space-y-4">
            <label
              class="block text-sm font-bold uppercase tracking-widest text-on-surface-variant"
            >
              <span set:html={data.pages.consulting.additionalContext} />
            </label>
            <textarea
              id="audio-description"
              class="w-full bg-white border border-outline-variant rounded-lg p-4 text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none min-h-[100px] transition-all font-body text-sm"
              placeholder={data.pages.consulting.placeholder}></textarea>
          </div>
          <div
            id="audio-error"
            class="hidden mt-4 text-sm text-red-600 bg-red-50 p-3 rounded-lg"
            role="alert"
          >
          </div>
          <div
            id="audio-success"
            class="hidden mt-4 text-sm text-green-700 bg-green-50 p-3 rounded-lg font-medium"
            role="status"
          >
          </div>
          <button
            id="submit-audio"
            class="w-full mt-6 bg-primary text-white font-bold py-4 rounded-xl flex items-center justify-center gap-2 transition-all hover:bg-primary/90 shadow-lg shadow-primary/20 disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            <span id="submit-audio-text"
              >{data.pages.consulting.submitAudio}</span
            >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M22 2L11 13"></path><path
                d="M22 2L15 22L11 13L2 9L22 2Z"></path></svg
            >
          </button>
        </div>
      </section>

      <section aria-labelledby="consult-form-heading">
        <div
          class="bg-surface-container-lowest border border-outline-variant/50 rounded-2xl p-8 shadow-sm"
        >
          <h3
            id="consult-form-heading"
            class="font-heading text-xl font-bold mb-6 text-on-surface"
          >
            {data.pages.consulting.consultForm.heading}
          </h3>
          <div
            id="consult-error"
            class="hidden mb-6 p-4 bg-red-50 text-red-600 rounded-lg text-sm font-medium"
            role="alert"
          >
          </div>
          <div
            id="consult-success"
            class="hidden mb-6 p-4 bg-green-50 text-green-700 rounded-lg text-sm font-medium font-bold"
            role="status"
          >
          </div>
          <form id="consult-form" class="space-y-6" novalidate>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label
                  for="c-fullname"
                  class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
                >
                  {data.pages.consulting.consultForm.fullName}
                  <span class="text-error">*</span>
                </label>
                <input
                  id="c-fullname"
                  type="text"
                  placeholder="John Doe"
                  required
                  class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-sm"
                />
                <p class="hidden text-xs text-red-500 mt-1" id="c-fullname-err">
                  {data.pages.consulting.validation.nameRequired}
                </p>
              </div>
              <div class="space-y-2">
                <label
                  for="c-company"
                  class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
                >
                  {data.pages.consulting.consultForm.company}
                  <span class="text-error">*</span>
                </label>
                <input
                  id="c-company"
                  type="text"
                  placeholder="Your company name"
                  required
                  class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-sm"
                />
                <p class="hidden text-xs text-red-500 mt-1" id="c-company-err">
                  {data.pages.consulting.validation.companyRequired}
                </p>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label
                  for="c-email"
                  class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
                >
                  {data.pages.consulting.consultForm.email}
                  <span class="text-error">*</span>
                </label>
                <input
                  id="c-email"
                  type="email"
                  placeholder="j.doe@acme.com"
                  required
                  class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-sm"
                />
                <p class="hidden text-xs text-red-500 mt-1" id="c-email-err">
                  {data.pages.consulting.validation.emailRequired}
                </p>
              </div>
              <div class="space-y-2">
                <label
                  for="c-phone"
                  class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
                >
                  {data.pages.consulting.consultForm.phone}
                </label>
                <input
                  id="c-phone"
                  type="tel"
                  placeholder="+1 (555) 000-0000"
                  class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-sm"
                />
              </div>
            </div>
            <div class="space-y-2">
              <label
                for="c-problem"
                class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
              >
                {data.pages.consulting.consultForm.problem}
                <span class="text-error">*</span>
              </label>
              <select
                id="c-problem"
                required
                class="w-full bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all appearance-none cursor-pointer text-sm"
              >
                {
                  data.pages.consulting.problems.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))
                }
              </select>
              <p class="hidden text-xs text-red-500 mt-1" id="c-problem-err">
                {data.pages.consulting.validation.problemRequired}
              </p>
            </div>
            <div class="space-y-2">
              <label
                for="c-goals"
                class="text-xs font-bold uppercase tracking-widest text-on-surface-variant"
              >
                {data.pages.consulting.consultForm.goals}
              </label>
              <textarea
                id="c-goals"
                rows="3"
                placeholder={data.pages.consulting.goalsPlaceholder}
                class="w-full h-36 bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all resize-none font-body text-sm"
              ></textarea>
            </div>
            <button
              type="submit"
              id="consult-submit-btn"
              class="w-full bg-primary text-white font-bold py-4 rounded-xl flex items-center justify-center gap-2 transition-all hover:bg-primary/90 shadow-lg shadow-primary/20"
            >
              <span id="consult-btn-text"
                >{data.pages.consulting.consultForm.submit}</span
              >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M22 2L11 13"></path><path
                  d="M22 2L15 22L11 13L2 9L22 2Z"></path></svg
              >
            </button>
          </form>
        </div>
      </section>
    </div>

    <section
      class="mt-24 pt-24 border-t border-outline-variant/30"
      aria-labelledby="method-heading"
    >
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span
          class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block"
          >{data.pages.consulting.portal}</span
        >
        <h2
          id="method-heading"
          class="font-heading text-3xl md:text-4xl font-bold text-on-surface tracking-tighter mb-4"
        >
          {data.pages.consulting.method}
        </h2>
        <p class="text-on-surface-variant text-lg font-body">
          {data.pages.consulting.description2}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        {
          [0, 1, 2].map((i) => {
            const title = data.pages.consulting.steps[i]?.title;
            const desc = data.pages.consulting.steps[i]?.desc;
            return (
              <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-2xl p-8 shadow-sm text-center">
                <div class="w-14 h-14 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container font-bold text-lg mx-auto mb-6">
                  {String(i + 1).padStart(2, "0")}
                </div>
                <h3 class="font-heading text-xl font-bold text-on-surface mb-3">
                  {title}
                </h3>
                <p class="text-on-surface-variant text-sm leading-relaxed font-body">
                  {desc}
                </p>
              </div>
            );
          })
        }
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div
          class="bg-white border border-outline-variant/30 rounded-2xl p-8 shadow-sm"
        >
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-16 h-16 rounded-full overflow-hidden border-2 border-primary/20 shrink-0"
            >
              <a href="https://www.linkedin.com/in/chriscadev/" target="_blank">
                <img
                  alt={data.pages.consulting.marcusThorne}
                  class="w-full h-full object-cover"
                  src="/christian-camacho.png"
                />
              </a>
            </div>
            <div>
              <p class="font-bold text-on-surface">
                {data.pages.consulting.marcusThorne}
              </p>
              <p
                class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold"
              >
                {data.pages.consulting.managingPartner}
              </p>
            </div>
          </div>
          <blockquote
            class="italic text-on-surface-variant text-sm leading-relaxed border-l-2 border-primary/30 pl-4"
          >
            &ldquo;{data.pages.consulting.quote}&rdquo;
          </blockquote>
        </div>

        <div class="bg-surface-container/50 rounded-2xl p-8 shadow-sm">
          <h3 class="font-heading text-lg font-bold mb-4 text-on-surface">
            {data.pages.consulting.officeHours}
          </h3>
          <div class="space-y-3 text-sm text-on-surface-variant font-body">
            <div class="flex items-start gap-3">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="text-primary mt-0.5 shrink-0"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
              <div>
                <p class="font-medium text-sm text-on-surface">
                  {data.pages.consulting.monFriHours}
                </p>
                <p class="text-xs text-on-surface-variant">
                  {data.pages.consulting.satHours}
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="text-primary mt-0.5 shrink-0"
                ><circle cx="12" cy="12" r="10"></circle><path
                  d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"
                ></path><circle cx="12" cy="12" r="3"></circle></svg
              >
              <p class="text-on-surface-variant text-sm">
                {data.pages.consulting.securityDesc}
              </p>
            </div>
            <div class="flex items-start gap-3">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="text-primary mt-0.5 shrink-0"
                ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                  d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"></path></svg
              >
              <p class="text-on-surface-variant text-sm">
                {data.pages.consulting.consultingEmail}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</DefaultLayout>

<div id="locale-data" data-json={DATA_JSON} hidden></div>
<script type="module" is:inline>
  import { initAudioRecorder, initConsultForm } from "../scripts/site.js";
  initAudioRecorder();
  const el = document.getElementById("locale-data");
  initConsultForm(JSON.parse(el?.getAttribute("data-json") || "{}"));
</script>
