---
import { getLocaleData } from "src/locales";
import DefaultLayout from "../components/layout/DefaultLayout.astro";
import ConsultingForm from "src/components/ConsultingForm";

const locale = Astro.url.pathname.split("/")[1] === "en" ? "en" : "es";
const data = getLocaleData(locale);
---

<DefaultLayout
  title={data.pages.consulting.title}
  description={data.pages.consulting.description}
  activeNav={data.nav.consulting}
  locale={locale}
>
  <div
    class="pt-32 pb-24 px-6 max-w-7xl mx-auto"
    aria-labelledby="consulting-heading"
  >
    <header
      aria-labelledby="consulting-heading"
      class="flex flex-col md:flex-row gap-8 md:gap-16 items-center mb-16"
    >
      <div class="flex-1">
        <span
          class="text-accent font-bold uppercase tracking-widest text-xs mb-4 block"
          >{data.pages.consulting.portal}</span
        >
        <h1
          id="consulting-heading"
          class="font-heading text-4xl md:text-6xl font-bold text-on-surface tracking-tighter mb-6"
          set:html={data.pages.consulting.heading}
        />
        <p
          class="text-on-surface-variant max-w-2xl text-lg leading-relaxed font-body"
        >
          {data.pages.consulting.description2}
        </p>
      </div>
      <div class="flex-1">
        <img
          src="/clarity.webp"
          alt=""
          class="rounded-xl w-full h-auto object-cover md:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_35%,black_100%)] md:[mask-image:linear-gradient(to_right,transparent_0%,black_35%,black_100%)]"
        />
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <ConsultingForm locale={data.pages.consulting} client:load />
      </div>

      <div class="space-y-8">
        <section aria-labelledby="method-heading">
          <span
            class="text-accent font-bold uppercase tracking-widest text-xs mb-2 block"
            >{data.pages.consulting.portal}</span
          >
          <h2
            id="method-heading"
            class="font-heading text-xl font-bold text-on-surface tracking-tighter mb-2"
          >
            {data.pages.consulting.method}
          </h2>
          <p class="text-on-surface-variant text-sm font-body mb-6">
            {data.pages.consulting.description2}
          </p>

          <div class="grid grid-cols-3 gap-4">
            {
              [0, 1, 2].map((i) => {
                const title = data.pages.consulting.steps[i]?.title;
                const desc = data.pages.consulting.steps[i]?.desc;
                return (
                  <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/30 text-center hover:border-primary/50 transition-all hover:shadow-md">
                    <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
                      <span class="font-heading text-base font-bold text-primary">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                    </div>
                    <h3 class="font-heading text-base font-bold text-on-surface mb-2">
                      {title}
                    </h3>
                    <p class="text-on-surface-variant text-xs font-body leading-relaxed">
                      {desc}
                    </p>
                  </div>
                );
              })
            }
          </div>
        </section>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div
            class="bg-white border border-outline-variant/30 rounded-2xl p-6 shadow-sm"
          >
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-12 h-12 rounded-full overflow-hidden border-2 border-primary/20 shrink-0"
              >
                <a
                  href="https://www.linkedin.com/in/chriscadev/"
                  target="_blank"
                >
                  <img
                    alt={data.pages.consulting.marcusThorne}
                    class="w-full h-full object-cover"
                    src="/christian-camacho.png"
                  />
                </a>
              </div>
              <div>
                <p class="font-bold text-sm text-on-surface">
                  {data.pages.consulting.marcusThorne}
                </p>
                <p
                  class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold"
                >
                  {data.pages.consulting.managingPartner}
                </p>
              </div>
            </div>
            <blockquote
              class="italic text-on-surface-variant text-xs leading-relaxed border-l-2 border-primary/30 pl-3"
            >
              &ldquo;{data.pages.consulting.quote}&rdquo;
            </blockquote>
          </div>

          <div class="bg-surface-container/50 rounded-2xl p-6 shadow-sm">
            <h3 class="font-heading text-base font-bold mb-3 text-on-surface">
              {data.pages.consulting.officeHours}
            </h3>
            <div class="space-y-2 text-xs text-on-surface-variant font-body">
              <div class="flex items-start gap-3">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="text-primary mt-0.5 shrink-0"
                  ><circle cx="12" cy="12" r="10"></circle><polyline
                    points="12 6 12 12 16 14"></polyline></svg
                >
                <div>
                  <p class="font-medium text-xs text-on-surface">
                    {data.pages.consulting.monFriHours}
                  </p>
                  <p class="text-[11px] text-on-surface-variant">
                    {data.pages.consulting.satHours}
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="text-primary mt-0.5 shrink-0"
                  ><circle cx="12" cy="12" r="10"></circle><path
                    d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"
                  ></path><circle cx="12" cy="12" r="3"></circle></svg
                >
                <p class="text-on-surface-variant text-xs">
                  {data.pages.consulting.securityDesc}
                </p>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="text-primary mt-0.5 shrink-0"
                  ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                    d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"></path></svg
                >
                <p class="text-on-surface-variant text-xs">
                  {data.pages.consulting.consultingEmail}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</DefaultLayout>
